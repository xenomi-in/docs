            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Activating a successor demotes the previous ACTIVE assignment" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    def rows = data.content
    assert rows.any { it.assignmentId.toString() == vars.get(&apos;NEXT_PAN_ASSIGNMENT_ID&apos;) &amp;&amp; it.assignmentStatus == &apos;ACTIVE&apos; }
    assert rows.any { it.assignmentStatus == &apos;DECRYPT_ONLY&apos; }
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;PAN key assignment supersede did not demote the previous ACTIVE row&apos;)
}</stringProp>
