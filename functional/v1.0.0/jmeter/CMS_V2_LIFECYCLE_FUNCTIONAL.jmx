            <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
            <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
          </JSONPostProcessor>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Ignore HTTP status" enabled="true">
            <collectionProp name="Asserion.test_strings"/>
            <stringProp name="Assertion.custom_message"></stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">true</boolProp>
            <intProp name="Assertion.test_type">1</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Require access token" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (prev.responseCode != &apos;200&apos; || !vars.get(&apos;TENANT_TOKEN&apos;) || vars.get(&apos;TENANT_TOKEN&apos;) == &apos;NOT_FOUND&apos;) {
    vars.put(&apos;TENANT_TOKEN&apos;, &apos;&apos;)
}</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223Assertion>
          <hashTree/>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="23.7 - Cross-tenant checks (only with a tenant-scoped client configured)" enabled="true">
          <stringProp name="IfController.condition">${__groovy(!vars.get(&apos;TENANT_TOKEN&apos;).isEmpty())}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="23.7.0 - S03 Confirm the second token is genuinely tenant-scoped" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">vars.put(&apos;TENANT_ISOLATION_READY&apos;, &apos;false&apos;)
def token = vars.get(&apos;TENANT_TOKEN&apos;)
def claims = new groovy.json.JsonSlurper().parseText(
    new String(Base64.getUrlDecoder().decode(token.split(&apos;\\.&apos;)[1]), &apos;UTF-8&apos;))
if (claims.platform_access?.toString() == &apos;true&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;TENANT_CLIENT_IS_PLATFORM&apos;)
    SampleResult.setResponseMessage(&apos;TENANT_KEYCLOAK_CLIENT_ID carries platform_access=true, so it bypasses the &apos; +
        &apos;tenant check and cannot prove isolation. Configure a client without platform access.&apos;)
} else if (!claims.institution_id || claims.institution_id.toString() == vars.get(&apos;INSTITUTION_ID&apos;)) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;TENANT_CLIENT_MISSCOPED&apos;)
    SampleResult.setResponseMessage(&apos;The tenant client institution_id is &apos; + claims.institution_id +
        &apos;, which must be present and different from this run institution &apos; + vars.get(&apos;INSTITUTION_ID&apos;))
} else {
    vars.put(&apos;TENANT_ISOLATION_READY&apos;, &apos;true&apos;)
    SampleResult.setResponseData(&apos;Tenant client is scoped to institution &apos; + claims.institution_id, &apos;UTF-8&apos;)
}</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223Sampler>
