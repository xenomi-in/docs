          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="28.9.3 - Require issued card: later card for block" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;STATUS_CARD_LATER3&apos;) != &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_NOT_CONFIRMED&apos;)
    SampleResult.setResponseMessage(&apos;later card for block did not reach CONFIRMED: status=&apos; + vars.get(&apos;STATUS_CARD_LATER3&apos;) +
        &apos;; operation=&apos; + vars.get(&apos;OP_CARD_LATER3&apos;) + &apos;; polls=&apos; + vars.get(&apos;POLL_CARD_LATER3&apos;) +
        &apos;; UNKNOWN observed &apos; + vars.get(&apos;UNKNOWN_CARD_LATER3&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;later card for block card &apos; + vars.get(&apos;CARD_LATER3&apos;), &apos;UTF-8&apos;)
}</stringProp>
