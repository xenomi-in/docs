            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="01.1 - Use the CMS institution mapped to Switch institution 10" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.sql.Sql
try {
    assert vars.get(&apos;ALLOW_TEST_FIXTURES&apos;) == &apos;true&apos;
    def institutionId = &apos;01a0a5f5-f71d-7d0f-ba69-a020a51bbbc1&apos;
    vars.put(&apos;INSTITUTION_ID&apos;, institutionId)
    def suffix = vars.get(&apos;RUN_SUFFIX&apos;)
    def code = &apos;FLB_&apos; + suffix
    def db = Sql.newInstance(vars.get(&apos;DB_URL&apos;), vars.get(&apos;DB_USERNAME&apos;), vars.get(&apos;DB_PASSWORD&apos;), &apos;org.postgresql.Driver&apos;)
    try {
        db.withTransaction {
            def inserted = db.executeUpdate(&apos;&apos;&apos;
insert into cms_v2.institution (
    institution_id, institution_name, institution_code, institution_short_name, institution_type,
    visa_member_flag, visa_member_id, rupay_member_flag,
    registered_address_line1, city, state_code, country_code, postal_code,
    contact_phone_primary, contact_email_primary, timezone,
    prepaid_card_issuing_enabled, credit_card_issuing_enabled, default_card_validity_months,
    base_currency, currency_exponent, business_date, status, created_by, updated_by)
select ?::uuid, ?, ?, &apos;FLB&apos;, &apos;BANK&apos;,
    true, ?, false,
    &apos;100 Test Avenue&apos;, &apos;Bengaluru&apos;, &apos;KA&apos;, &apos;IND&apos;, &apos;560001&apos;,
    &apos;+919900000001&apos;, ?, &apos;Asia/Kolkata&apos;,
    false, true, 60,
    &apos;INR&apos;, 2, ?::date, &apos;ACTIVE&apos;, ?, ?
where not exists (select 1 from cms_v2.institution where institution_id = ?::uuid)
&apos;&apos;&apos;, [institutionId, &apos;Falcon Lifecycle Bank &apos; + suffix, code, &apos;VISA-&apos; + suffix,
      &apos;cards-&apos; + suffix + &apos;@falcontest.example&apos;, vars.get(&apos;BUSINESS_DATE&apos;),
      vars.get(&apos;CMS_ACTOR_ID&apos;), vars.get(&apos;CMS_ACTOR_ID&apos;), institutionId])
            def updated = db.executeUpdate(&apos;&apos;&apos;
update cms_v2.institution
set institution_name = ?, institution_code = ?, visa_member_id = ?, contact_email_primary = ?,
    business_date = ?::date, status = &apos;ACTIVE&apos;, updated_by = ?, updated_at = now()
where institution_id = ?::uuid
&apos;&apos;&apos;, [&apos;Falcon Lifecycle Bank &apos; + suffix, code, &apos;VISA-&apos; + suffix,
      &apos;cards-&apos; + suffix + &apos;@falcontest.example&apos;, vars.get(&apos;BUSINESS_DATE&apos;),
      vars.get(&apos;CMS_ACTOR_ID&apos;), institutionId])
            assert updated == 1 : &apos;Mapped institution was not stored&apos;
            SampleResult.setResponseData((inserted == 1 ? &apos;Created&apos; : &apos;Reused&apos;) + &apos; institution &apos; + institutionId + &apos; as &apos; + code, &apos;UTF-8&apos;)
        }
    } finally { db.close() }
} catch (Exception | AssertionError failure) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;FIXTURE_ERROR&apos;)
    SampleResult.setResponseMessage(failure.message ?: &apos;Could not store the mapped institution&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
}</stringProp>
