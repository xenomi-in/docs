            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="19.12.2 - Require Switch settled: Q08 successor registration" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">if (vars.get(&apos;SWITCH_SYNC_DISABLED&apos;) == &apos;true&apos;) {
    SampleResult.setResponseMessage(&apos;Durable Switch synchronization is disabled on this CMS instance&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
    return
}
if (vars.get(&apos;SYNC_SUCC_Q&apos;) != &apos;true&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(vars.get(&apos;SYNC_FAILED_SUCC_Q&apos;) == &apos;true&apos; ? &apos;SWITCH_SYNC_FAILED&apos; : &apos;SWITCH_SYNC_TIMEOUT&apos;)
    SampleResult.setResponseMessage(&apos;Switch did not settle for Q08 successor registration within &apos; +
        vars.get(&apos;SWITCH_SYNC_MAX_POLLS&apos;) + &apos; polls; appliedRevision=&apos; + vars.get(&apos;REV_SUCC_Q&apos;) +
        &apos;; pending=&apos; + vars.get(&apos;PENDING_SUCC_Q&apos;))
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
    // Stop this dependent area, record the failed sample, and let other groups run.
    SampleResult.setStopThread(true)
    return
}
SampleResult.setResponseData(&apos;Q08 successor registration settled at Switch revision &apos; + vars.get(&apos;REV_SUCC_Q&apos;), &apos;UTF-8&apos;)</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
            </JSR223Sampler>
            <hashTree/>
          </hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="19.13 - Q08 The Switch keeps the two same-PAN generations apart" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.sql.Sql
def switchTableColumns = { db, table -&gt;
    db.rows(&apos;&apos;&apos;
select column_name
from information_schema.columns
where table_schema = current_schema()
  and table_name = ?
order by ordinal_position
&apos;&apos;&apos;, [table]).collect { it.column_name.toString() }
}
def switchCardIdColumn = { db, table -&gt;
    def names = switchTableColumns(db, table)
    def preferred = [&apos;cms_card_id&apos;, &apos;card_id&apos;, &apos;cms_card_uuid&apos;, &apos;card_uuid&apos;, &apos;cms_card_reference&apos;, &apos;external_card_id&apos;]
    return preferred.find { names.contains(it) }
}
def stage = &apos;check whether the comparison applies&apos;
try {
    if (vars.get(&apos;WAIT_FOR_SWITCH_SYNC&apos;) != &apos;true&apos; || vars.get(&apos;SWITCH_SYNC_DISABLED&apos;) == &apos;true&apos;) {
        SampleResult.setResponseData(&apos;Skipped; durable Switch synchronization is not enabled for this run&apos;, &apos;UTF-8&apos;)
        return
    }
    def source = vars.get(&apos;CARD_Q&apos;)
    def successor = vars.get(&apos;SUCC_Q&apos;)
    assert source &amp;&amp; successor : &apos;Both generations must exist&apos;
    stage = &apos;connect to the Switch database&apos;
    def db = Sql.newInstance(vars.get(&apos;SWITCH_DB_URL&apos;), vars.get(&apos;SWITCH_DB_USERNAME&apos;), vars.get(&apos;SWITCH_DB_PASSWORD&apos;) ?: &apos;&apos;, &apos;org.postgresql.Driver&apos;)
    try {
        stage = &apos;read both profiles&apos;
        def column = switchCardIdColumn(db, &apos;cms_card_profile&apos;)
        assert column : &apos;No CMS card id column found on cms_card_profile; columns=&apos; + switchTableColumns(db, &apos;cms_card_profile&apos;)
        def sourceRows = db.rows(&apos;select * from cms_card_profile where &apos; + column + &apos; = ?::uuid&apos;, [source])
        def successorRows = db.rows(&apos;select * from cms_card_profile where &apos; + column + &apos; = ?::uuid&apos;, [successor])
        assert sourceRows.size() == 1 : &apos;The source generation has &apos; + sourceRows.size() + &apos; Switch profiles&apos;
        assert successorRows.size() == 1 : &apos;The successor generation has &apos; + successorRows.size() + &apos; Switch profiles&apos;
        assert sourceRows[0][column].toString() != successorRows[0][column].toString() :
            &apos;Both generations resolved to the same Switch profile row; a same-PAN update could target the wrong generation&apos;
        SampleResult.setResponseData(&apos;Source and successor hold separate Switch profiles&apos;, &apos;UTF-8&apos;)
    } finally { db.close() }
} catch (Exception | AssertionError failure) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;SWITCH_SAME_PAN_ROUTING&apos;)
    SampleResult.setResponseMessage(&apos;Same-PAN routing check failed at: &apos; + stage + &apos;; error=&apos; + (failure.message ?: failure.class.simpleName))
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
}</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="20 - R. Idempotency across every mutation" enabled="true">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="20.0 - Load shared configuration for idempotency" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">try {
    def missing = []
    [&apos;RUN_ID&apos;,&apos;RUN_SUFFIX&apos;,&apos;INSTITUTION_ID&apos;,&apos;BIN_ID&apos;,&apos;BIN_NUMBER&apos;,&apos;BIN_RANGE_ID&apos;,&apos;UNASSIGNED_RANGE_ID&apos;,&apos;PRODUCT_ID&apos;,&apos;PRODUCT_VERSION_ID&apos;,&apos;BIN_ASSIGNMENT_ID&apos;,&apos;CEILING_PRODUCT_ID&apos;,&apos;CEILING_PRODUCT_VERSION_ID&apos;,&apos;DRAFT_PRODUCT_ID&apos;,&apos;DRAFT_PRODUCT_VERSION_ID&apos;,&apos;CUSTOMER_REFERENCE_ID&apos;,&apos;SECOND_CUSTOMER_REFERENCE_ID&apos;,&apos;ACTIVATION_POLICY_VERSION_ID&apos;,&apos;RENEWAL_POLICY_ID&apos;,&apos;DAMAGED_POLICY_ID&apos;,&apos;LOST_POLICY_ID&apos;,&apos;STOLEN_POLICY_ID&apos;,&apos;COMPROMISED_POLICY_ID&apos;,&apos;BLOCKED_REASON_POLICY_ID&apos;,&apos;BIN8_ID&apos;,&apos;BIN8_NUMBER&apos;,&apos;VENDOR_ID&apos;,&apos;BATCH_CONFIG_ID&apos;,&apos;ADDRESS_REF_ID&apos;,&apos;VIRTUAL_DESIGN_ID&apos;,&apos;PHYSICAL_DESIGN_ID&apos;,&apos;TECH_PROFILE_ID&apos;,&apos;CVM_PROFILE_ID&apos;,&apos;LIMIT_ID&apos;,&apos;MAIN_PRODUCT_CODE&apos;,&apos;PHYS_LATER_PRODUCT_ID&apos;,&apos;PHYS_LATER_VERSION_ID&apos;,&apos;PHYS_ONLY_PRODUCT_ID&apos;,&apos;PHYS_ONLY_VERSION_ID&apos;,&apos;SAME_DAY_PRODUCT_ID&apos;,&apos;SAME_DAY_VERSION_ID&apos;,&apos;MULTI_PRODUCT_ID&apos;,&apos;MULTI_VERSION_ID&apos;,&apos;PAN_ENCRYPTION_KEY_ID&apos;,&apos;PAN_HMAC_KEY_ID&apos;,&apos;CVV_KEY_ID&apos;,&apos;EMV_IMK_KEY_ID&apos;,&apos;BUSINESS_DATE&apos;,&apos;EFFECTIVE_FROM&apos;,&apos;RANGE_START&apos;,&apos;RANGE_END&apos;,&apos;UNASSIGNED_RANGE_START&apos;,&apos;UNASSIGNED_RANGE_END&apos;,&apos;ACCOUNT_REF_1&apos;,&apos;ACCOUNT_REF_2&apos;,&apos;ACCOUNT_REF_3&apos;,&apos;ACCOUNT_REF_4&apos;,&apos;ACCOUNT_REF_5&apos;,&apos;ACCOUNT_REF_6&apos;,&apos;ACCOUNT_REF_7&apos;,&apos;ACCOUNT_REF_8&apos;,&apos;ACCOUNT_REF_9&apos;,&apos;ACCOUNT_REF_10&apos;,&apos;ACCOUNT_REF_11&apos;,&apos;ACCOUNT_REF_12&apos;,&apos;ACCOUNT_REF_13&apos;,&apos;ACCOUNT_REF_14&apos;,&apos;ACCOUNT_REF_15&apos;,&apos;ACCOUNT_REF_16&apos;,&apos;ACCOUNT_REF_17&apos;,&apos;ACCOUNT_REF_18&apos;,&apos;ACCOUNT_REF_19&apos;,&apos;ACCOUNT_REF_20&apos;,&apos;ACCOUNT_REF_21&apos;,&apos;ACCOUNT_REF_22&apos;,&apos;ACCOUNT_REF_23&apos;,&apos;ACCOUNT_REF_24&apos;,&apos;ACCOUNT_REF_25&apos;,&apos;ACCOUNT_REF_26&apos;,&apos;ACCOUNT_REF_27&apos;,&apos;ACCOUNT_REF_28&apos;,&apos;ACCOUNT_REF_29&apos;,&apos;ACCOUNT_REF_30&apos;,&apos;ACCOUNT_REF_31&apos;,&apos;ACCOUNT_REF_32&apos;,&apos;ACCOUNT_REF_33&apos;,&apos;ACCOUNT_REF_34&apos;,&apos;ACCOUNT_REF_35&apos;,&apos;ACCOUNT_REF_36&apos;,&apos;ACCOUNT_REF_37&apos;,&apos;ACCOUNT_REF_38&apos;,&apos;ACCOUNT_REF_39&apos;,&apos;ACCOUNT_REF_40&apos;].each { key -&gt;
        def value = props.get(&apos;LF_&apos; + key)
        if (value == null || value.toString().trim().isEmpty()) {
            missing &lt;&lt; key
        } else {
            vars.put(key, value.toString())
        }
    }
    assert missing.isEmpty() : &apos;The bootstrap thread group did not publish: &apos; + missing +
        &apos;. Run the whole plan in order; area groups cannot run against an empty property map.&apos;
    vars.put(&apos;AREA&apos;, &apos;idempotency&apos;)
    SampleResult.setResponseData(&apos;Loaded shared configuration for idempotency: institution &apos; + vars.get(&apos;INSTITUTION_ID&apos;), &apos;UTF-8&apos;)
} catch (Exception | AssertionError failure) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;BOOTSTRAP_MISSING&apos;)
    SampleResult.setResponseMessage(failure.message ?: &apos;Shared configuration is unavailable&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
    // Without the shared configuration every sampler below would fail against a real API,
    // so end this area rather than generating noise.
    SampleResult.setStopThread(true)
}</stringProp>
