                <stringProp name="Assertion.custom_message"></stringProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                <boolProp name="Assertion.assume_success">true</boolProp>
                <intProp name="Assertion.test_type">1</intProp>
              </ResponseAssertion>
              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Record whether card limits can be set here" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">try {
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    if (prev.responseCode == &apos;200&apos;) {
        vars.put(&apos;ACCOUNTING_LIMITS&apos;, &apos;available&apos;)
        prev.setResponseMessage(&apos;Accounting card-limit integration is available; the boundary cases will run&apos;)
        return
    }
    def message = (envelope.error?.message ?: envelope.message ?: &apos;&apos;).toString()
    if (message.toLowerCase().contains(&apos;accounting&apos;)) {
        vars.put(&apos;ACCOUNTING_LIMITS&apos;, &apos;unconfigured&apos;)
        prev.setResponseMessage(&apos;SKIPPING the limit boundary cases: &apos; + message)
        return
    }
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;A 1000-minor card limit was refused for a reason unrelated to Accounting: HTTP &apos; +
        prev.responseCode + &apos; &apos; + message)
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Could not probe the Accounting card-limit integration&apos;)
}</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
              </JSR223Assertion>
              <hashTree/>
            </hashTree>
          </hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="15.4 - Limit boundaries (only when Accounting card limits are configured)" enabled="true">
            <stringProp name="IfController.condition">${__groovy(vars.get(&apos;ACCOUNTING_LIMITS&apos;) == &apos;available&apos;)}</stringProp>
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
