          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="29.5.4.3 - Require completed replacement: COMPROMISED new-PAN security replacement" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def successor = vars.get(&apos;SUCC_COMP&apos;)
if (!(vars.get(&apos;RSTATUS_SUCC_COMP&apos;) in [&apos;CONFIRMED&apos;, &apos;COMPLETED&apos;]) || !successor || successor == &apos;NOT_FOUND&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;REPLACEMENT_NOT_COMPLETED&apos;)
    SampleResult.setResponseMessage(&apos;COMPROMISED new-PAN security replacement status=&apos; + vars.get(&apos;RSTATUS_SUCC_COMP&apos;) + &apos;; request=&apos; + vars.get(&apos;RREQ_SUCC_COMP&apos;) +
        &apos;; polls=&apos; + vars.get(&apos;RPOLL_SUCC_COMP&apos;) + &apos;; UNKNOWN observed &apos; + vars.get(&apos;RUNKNOWN_SUCC_COMP&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;COMPROMISED new-PAN security replacement successor &apos; + successor + &apos; (resolved PAN strategy &apos; +
        (vars.get(&apos;RRESOLVED_SUCC_COMP&apos;) ?: &apos;not reported&apos;) + &apos;)&apos;, &apos;UTF-8&apos;)
