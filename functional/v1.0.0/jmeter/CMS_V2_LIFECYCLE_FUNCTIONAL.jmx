            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Issuance accepted" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode == &apos;202&apos; : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.operationId
    vars.put(&apos;OP_CARD_RB&apos;, data.operationId.toString())
    vars.put(&apos;STATUS_CARD_RB&apos;, data.status.toString())
    if (data.status == &apos;CONFIRMED&apos;) {
        vars.put(&apos;CARD_RB&apos;, data.result.cards[0].cardId.toString())
        vars.put(&apos;CONT_CARD_RB&apos;, &apos;false&apos;)
    } else if (data.status == &apos;FAILED&apos;) {
        vars.put(&apos;CONT_CARD_RB&apos;, &apos;false&apos;)
    }
} catch (Exception | AssertionError failure) {
    vars.put(&apos;CONT_CARD_RB&apos;, &apos;false&apos;)
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Issuance submit failed&apos;)
}</stringProp>
