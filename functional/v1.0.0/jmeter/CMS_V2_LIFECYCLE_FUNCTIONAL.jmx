              <stringProp name="HTTPSampler.path">/cms/api/v2/institutions/${INSTITUTION_ID}/cards/issuance-operations/${OP_B02A}</stringProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
                <collectionProp name="Arguments.arguments">
                </collectionProp>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Poll interval" enabled="true">
                <stringProp name="ConstantTimer.delay">${POLL_INTERVAL_MS}</stringProp>
              </ConstantTimer>
              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Capture status" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">try {
    vars.put(&apos;POLL_B02A&apos;, (Integer.parseInt(vars.get(&apos;POLL_B02A&apos;)) + 1).toString())
    assert prev.responseCode == &apos;200&apos;
    def data = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString).data
    vars.put(&apos;STATUS_B02A&apos;, data.status.toString())
    // There is no failure-reason column on the operation; &apos;result&apos; is the only payload.
    vars.put(&apos;REASON_B02A&apos;, (data.result ?: &apos;no result payload&apos;).toString())
    if (data.status in [&apos;FAILED&apos;, &apos;CONFIRMED&apos;]) vars.put(&apos;CONT_B02A&apos;, &apos;false&apos;)
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Poll failed&apos;)
}</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
              </JSR223Assertion>
              <hashTree/>
            </hashTree>
          </hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="11.2.3 - Require no card was created: B02 unknown account reference" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;SYNCREJECT_B02A&apos;) == &apos;true&apos;) {
    SampleResult.setResponseData(&apos;B02 unknown account reference was refused synchronously&apos;, &apos;UTF-8&apos;)
    return
}
def status = vars.get(&apos;STATUS_B02A&apos;)
if (status == &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;RULE_NOT_ENFORCED&apos;)
    SampleResult.setResponseMessage(&apos;B02 unknown account reference produced a usable card; operation &apos; + vars.get(&apos;OP_B02A&apos;) +
        &apos; reached CONFIRMED.&apos; + &apos; No rule in the issuance path rejected it.&apos;)
} else {
    // FAILED is never written by application code, so a stuck PENDING/UNKNOWN is the real
    // signature of a worker-side abort. Either way no card became usable, but an operation
    // that never resolves is its own defect and is reported as one.
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_UNRESOLVED&apos;)
    SampleResult.setResponseMessage(&apos;B02 unknown account reference was accepted with HTTP 202 and then never resolved: &apos; +
        vars.get(&apos;POLL_B02A&apos;) + &apos; polls, last status=&apos; + status + &apos;, result=&apos; + vars.get(&apos;REASON_B02A&apos;) +
        &apos;. The precondition should have been refused at submission.&apos;)
}
SampleResult.setResponseData(SampleResult.getResponseMessage() ?: &apos;&apos;, &apos;UTF-8&apos;)</stringProp>
