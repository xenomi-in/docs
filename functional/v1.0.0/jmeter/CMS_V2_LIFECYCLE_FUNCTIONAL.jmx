    assert data.cardId != vars.get(&apos;CARD_RB_STOLEN&apos;) : &apos;Replacement returned the source as its successor&apos;
    assert data.maskedPan != vars.get(&apos;CARD_RB_STOLEN_PAN&apos;) : &apos;Successor kept the source PAN &apos; + data.maskedPan
    assert data.cardStatus == &apos;PENDING&apos; : &apos;successor cardStatus is &apos; + data.cardStatus
    assert data.accountReferenceId == vars.get(&apos;ACCOUNT_REF_37&apos;) : &apos;Successor lost the account link&apos;
    assert data.customerReferenceId == vars.get(&apos;CUSTOMER_REFERENCE_ID&apos;)
    assert vars.get(&apos;RRESOLVED_SUCC_STOLEN&apos;) == &apos;GENERATE_NEW_PAN&apos; : &apos;resolvedPanStrategy is &apos; + vars.get(&apos;RRESOLVED_SUCC_STOLEN&apos;)
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;STOLEN successor was not created correctly&apos;)
}</stringProp>
