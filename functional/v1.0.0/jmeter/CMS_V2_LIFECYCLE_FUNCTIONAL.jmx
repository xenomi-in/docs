            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;STATUS_CARD_R&apos;) != &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_NOT_CONFIRMED&apos;)
    SampleResult.setResponseMessage(&apos;R idempotency card did not reach CONFIRMED: status=&apos; + vars.get(&apos;STATUS_CARD_R&apos;) +
        &apos;; operation=&apos; + vars.get(&apos;OP_CARD_R&apos;) + &apos;; polls=&apos; + vars.get(&apos;POLL_CARD_R&apos;) +
        &apos;; UNKNOWN observed &apos; + vars.get(&apos;UNKNOWN_CARD_R&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;R idempotency card card &apos; + vars.get(&apos;CARD_R&apos;), &apos;UTF-8&apos;)
}</stringProp>
