            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;operationId&quot;:&quot;${__UUID()}&quot;,&quot;policyProfileVersion&quot;:1,&quot;expectedPinVersion&quot;:0,&quot;authorizationReference&quot;:&quot;lf-pin-grant&quot;,&quot;currentPin&quot;:{&quot;encryptedPinBlock&quot;:&quot;0123456789ABCDEF&quot;,&quot;format&quot;:&quot;ISO_0&quot;,&quot;keyBindingReference&quot;:&quot;lf.pin.input.v1&quot;},&quot;newPin&quot;:{&quot;encryptedPinBlock&quot;:&quot;FEDCBA9876543210&quot;,&quot;format&quot;:&quot;ISO_0&quot;,&quot;keyBindingReference&quot;:&quot;lf.pin.input.v1&quot;}}</stringProp>
