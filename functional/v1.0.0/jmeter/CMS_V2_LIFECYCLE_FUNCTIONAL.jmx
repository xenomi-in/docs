vars.put(&apos;POLL_CARD_B1&apos;, &apos;0&apos;)
vars.put(&apos;CONT_CARD_B1&apos;, &apos;true&apos;)
vars.put(&apos;STATUS_CARD_B1&apos;, &apos;PENDING&apos;)
vars.put(&apos;UNKNOWN_CARD_B1&apos;, &apos;0&apos;)</stringProp>
