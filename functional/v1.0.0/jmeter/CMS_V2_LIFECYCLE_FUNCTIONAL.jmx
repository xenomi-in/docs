          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="15.2b - Derive the limit boundary values" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def ceiling = Long.parseLong(vars.get(&apos;PRODUCT_LIMIT_MAX_MINOR&apos;))
assert ceiling &gt; 0 : &apos;PRODUCT_LIMIT_MAX_MINOR must be positive&apos;
vars.put(&apos;LIMIT_AT_CEILING&apos;, ceiling.toString())
vars.put(&apos;LIMIT_OVER_CEILING&apos;, (ceiling + 1).toString())
vars.put(&apos;ACCOUNTING_LIMITS&apos;, vars.get(&apos;SKIP_ACCOUNTING_TESTS&apos;) == &apos;true&apos; ? &apos;excluded&apos; : &apos;unknown&apos;)
SampleResult.setResponseData(&apos;Boundary values &apos; + ceiling + &apos; and &apos; + (ceiling + 1), &apos;UTF-8&apos;)</stringProp>
