          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="28.1.3 - Require issued card: virtual-then-physical card" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;STATUS_CARD_LATER&apos;) != &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_NOT_CONFIRMED&apos;)
    SampleResult.setResponseMessage(&apos;virtual-then-physical card did not reach CONFIRMED: status=&apos; + vars.get(&apos;STATUS_CARD_LATER&apos;) +
        &apos;; operation=&apos; + vars.get(&apos;OP_CARD_LATER&apos;) + &apos;; polls=&apos; + vars.get(&apos;POLL_CARD_LATER&apos;) +
        &apos;; UNKNOWN observed &apos; + vars.get(&apos;UNKNOWN_CARD_LATER&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;virtual-then-physical card card &apos; + vars.get(&apos;CARD_LATER&apos;), &apos;UTF-8&apos;)
}</stringProp>
