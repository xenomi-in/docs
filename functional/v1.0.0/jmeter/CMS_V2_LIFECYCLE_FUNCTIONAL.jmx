            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Verify rejection" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    def accepted = [&apos;400&apos;,&apos;422&apos;]
    assert prev.responseCode in accepted : &apos;Expected a rejection in &apos; + accepted + &apos; but got HTTP &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == false : &apos;Rejection did not return a failure envelope&apos;
    def errorCode = envelope.error?.code ?: envelope.errorCode ?: &apos;not reported&apos;
    assert (envelope.error?.message ?: &apos;&apos;).toLowerCase().contains(&apos;draft&apos;)
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;An ACTIVE card design accepted a name change&apos;)
}</stringProp>
