            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">vars.put(&apos;BODY_CARD_A09&apos;, groovy.json.JsonOutput.toJson([
    customerReferenceId: vars.get(&apos;CUSTOMER_REFERENCE_ID&apos;),
    accountReferenceId: vars.get(&apos;ACCOUNT_REF_3&apos;),
    productId: vars.get(&apos;PRODUCT_ID&apos;),
    productVersionId: vars.get(&apos;PRODUCT_VERSION_ID&apos;),
    binRangeId: vars.get(&apos;BIN_RANGE_ID&apos;),
    activationPolicyVersionId: vars.get(&apos;ACTIVATION_POLICY_VERSION_ID&apos;),
    accountLinkType: &apos;PRIMARY_FUNDING&apos;,
    embossedNameLine1: &apos;LF A09 virtual card&apos;
]))
vars.put(&apos;KEY_CARD_A09&apos;, vars.get(&apos;RUN_ID&apos;) + &apos;-a09&apos;)
vars.put(&apos;POLL_CARD_A09&apos;, &apos;0&apos;)
vars.put(&apos;CONT_CARD_A09&apos;, &apos;true&apos;)
vars.put(&apos;STATUS_CARD_A09&apos;, &apos;PENDING&apos;)
vars.put(&apos;UNKNOWN_CARD_A09&apos;, &apos;0&apos;)</stringProp>
