            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">vars.put(&apos;BODY_A02&apos;, groovy.json.JsonOutput.toJson([customerReferenceId: vars.get(&apos;CUSTOMER_REFERENCE_ID&apos;), accountReferenceId: vars.get(&apos;ACCOUNT_REF_24&apos;), productId: vars.get(&apos;PRODUCT_ID&apos;), productVersionId: vars.get(&apos;PRODUCT_VERSION_ID&apos;), binRangeId: vars.get(&apos;BIN_RANGE_ID&apos;), activationPolicyVersionId: vars.get(&apos;ACTIVATION_POLICY_VERSION_ID&apos;), accountLinkType: &apos;PRIMARY_FUNDING&apos;, embossedNameLine1: &apos;LF NEGATIVE&apos;]))
