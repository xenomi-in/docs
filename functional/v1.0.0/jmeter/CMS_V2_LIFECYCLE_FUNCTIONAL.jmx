            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="41.46 - W20 W21 W23 Card B new profile, design and CVK lineage" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.sql.Sql
try {
    assert vars.get(&apos;ALLOW_TEST_FIXTURES&apos;) == &apos;true&apos;
    def expected = vars.get(&apos;EXPECTED_TEST_DATABASE&apos;)
    assert expected &amp;&amp; vars.get(&apos;DB_URL&apos;).contains(&apos;/&apos; + expected) : &apos;Expected test database is required&apos;
    def db = Sql.newInstance(vars.get(&apos;DB_URL&apos;), vars.get(&apos;DB_USERNAME&apos;), vars.get(&apos;DB_PASSWORD&apos;), &apos;org.postgresql.Driver&apos;)
    try {
        def row = db.firstRow(&apos;select c.card_id,c.product_id,c.product_version_id,c.bin_id,c.bin_range_id,c.card_design_id,c.technology_profile_id,c.cvm_profile_id,c.cvv_key_id,c.expiry_date,p.maximum_attempts from cms_v2.card c join cms_v2.pin_data p on p.pin_data_id=c.pin_data_ref and p.institution_id=c.institution_id where c.institution_id=?::uuid and c.card_id=?::uuid&apos;,[vars.get(&apos;INSTITUTION_ID&apos;),vars.get(&apos;CLIENT_CARD_B&apos;)])
        assert row
        def snapshot = row.collectEntries { k,v -&gt; [(k.toString()):v?.toString()] }
        assert snapshot.product_version_id == vars.get(&apos;CLIENT_V2_ID&apos;)
        assert snapshot.card_design_id == vars.get(&apos;CLIENT_DESIGN_B&apos;)
        assert snapshot.technology_profile_id == vars.get(&apos;CLIENT_TECH_B&apos;)
        assert snapshot.cvm_profile_id == vars.get(&apos;CLIENT_CVM_B&apos;)
        assert snapshot.cvv_key_id == vars.get(&apos;CVV_KEY_ID&apos;)
        assert snapshot.maximum_attempts == &apos;5&apos;
        def old = new groovy.json.JsonSlurper().parseText(vars.get(&apos;CLIENT_CARD_A_SNAPSHOT&apos;))
        assert snapshot.expiry_date != old.expiry_date
        SampleResult.setResponseData(groovy.json.JsonOutput.toJson(snapshot),&apos;UTF-8&apos;)
    } finally { db.close() }
} catch (Exception | AssertionError failure) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;CLIENT_CONFIGURATION_FAILED&apos;)
    SampleResult.setResponseMessage(failure.message ?: &apos;Client configuration assertion failed&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
}</stringProp>
