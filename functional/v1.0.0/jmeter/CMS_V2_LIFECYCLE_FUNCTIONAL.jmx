              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Capture issuance status" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">try {
    vars.put(&apos;POLL_CARD_B2&apos;, (Integer.parseInt(vars.get(&apos;POLL_CARD_B2&apos;)) + 1).toString())
    assert prev.responseCode == &apos;200&apos; : &apos;Unexpected HTTP status: &apos; + prev.responseCode
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    vars.put(&apos;STATUS_CARD_B2&apos;, data.status.toString())
    if (data.status == &apos;UNKNOWN&apos;) {
        vars.put(&apos;UNKNOWN_CARD_B2&apos;, (Integer.parseInt(vars.get(&apos;UNKNOWN_CARD_B2&apos;)) + 1).toString())
    }
    if (data.status == &apos;CONFIRMED&apos;) {
        assert data.result.cards.size() == 1
        vars.put(&apos;CARD_B2&apos;, data.result.cards[0].cardId.toString())
        vars.put(&apos;CONT_CARD_B2&apos;, &apos;false&apos;)
    } else if (data.status == &apos;FAILED&apos;) {
        vars.put(&apos;CONT_CARD_B2&apos;, &apos;false&apos;)
    }
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Issuance poll failed&apos;)
}</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
              </JSR223Assertion>
              <hashTree/>
            </hashTree>
          </hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="11.4.3 - Require issued card: B04 second card on shared account" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;STATUS_CARD_B2&apos;) != &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_NOT_CONFIRMED&apos;)
    SampleResult.setResponseMessage(&apos;B04 second card on shared account did not reach CONFIRMED: status=&apos; + vars.get(&apos;STATUS_CARD_B2&apos;) +
        &apos;; operation=&apos; + vars.get(&apos;OP_CARD_B2&apos;) + &apos;; polls=&apos; + vars.get(&apos;POLL_CARD_B2&apos;) +
        &apos;; UNKNOWN observed &apos; + vars.get(&apos;UNKNOWN_CARD_B2&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;B04 second card on shared account card &apos; + vars.get(&apos;CARD_B2&apos;), &apos;UTF-8&apos;)
}</stringProp>
