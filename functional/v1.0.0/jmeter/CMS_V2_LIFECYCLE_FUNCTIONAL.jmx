            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Initialize stays at version zero" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == false : &apos;Initialize returned a success envelope&apos;
    def message = (envelope.error?.message ?: &apos;&apos;).toString()
    def notConfirmed = prev.responseCode == &apos;409&apos; &amp;&amp; message.contains(&apos;not confirmed&apos;)
    def wrongVersion = prev.responseCode == &apos;422&apos; &amp;&amp; message.contains(&apos;unestablished customer-selected profile&apos;)
    assert notConfirmed || wrongVersion : &apos;Expected a profile-version or selection-version refusal, got HTTP &apos; + prev.responseCode + &apos;: &apos; + message
    assert !prev.responseDataAsString.toLowerCase().contains(&apos;fedcba9876543210&apos;)
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Initialize version check was unexpected&apos;)
}</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
