          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="29.3.1.3 - Require issued card: LOST security source" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;STATUS_CARD_RB&apos;) != &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_NOT_CONFIRMED&apos;)
    SampleResult.setResponseMessage(&apos;LOST security source did not reach CONFIRMED: status=&apos; + vars.get(&apos;STATUS_CARD_RB&apos;) +
        &apos;; operation=&apos; + vars.get(&apos;OP_CARD_RB&apos;) + &apos;; polls=&apos; + vars.get(&apos;POLL_CARD_RB&apos;) +
        &apos;; UNKNOWN observed &apos; + vars.get(&apos;UNKNOWN_CARD_RB&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;LOST security source card &apos; + vars.get(&apos;CARD_RB&apos;), &apos;UTF-8&apos;)
}</stringProp>
