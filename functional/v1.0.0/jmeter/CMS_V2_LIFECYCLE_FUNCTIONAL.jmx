          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="41.37a - W23 Prepare rotation using only newly generated HSM wrapped key" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.sql.Sql
try {
    assert vars.get(&apos;ALLOW_TEST_FIXTURES&apos;) == &apos;true&apos;
    def expected = vars.get(&apos;EXPECTED_TEST_DATABASE&apos;)
    assert expected &amp;&amp; vars.get(&apos;DB_URL&apos;).contains(&apos;/&apos; + expected) : &apos;Expected test database is required&apos;
    def db = Sql.newInstance(vars.get(&apos;DB_URL&apos;), vars.get(&apos;DB_USERNAME&apos;), vars.get(&apos;DB_PASSWORD&apos;), &apos;org.postgresql.Driver&apos;)
    try {
        def row = db.firstRow(&quot;select encrypted_key_block,key_check_value from cms_v2.hsm_key_reference where institution_id=?::uuid and key_id=?::uuid and key_type=&apos;CVK&apos; and bin_id=?::uuid&quot;,[vars.get(&apos;INSTITUTION_ID&apos;),vars.get(&apos;CLIENT_GENERATED_CVK&apos;),vars.get(&apos;BIN_ID&apos;)])
        assert row &amp;&amp; row.encrypted_key_block &amp;&amp; row.key_check_value
        vars.put(&apos;CLIENT_ROTATION_BODY&apos;,groovy.json.JsonOutput.toJson([keyLabel:&apos;CLIENT ROTATED CVK &apos;+vars.get(&apos;RUN_SUFFIX&apos;),keyCheckValue:row.key_check_value,effectiveFrom:vars.get(&apos;BUSINESS_DATE&apos;),expiryDate:&apos;2035-01-01&apos;,rotationReason:&apos;CLIENT_FUNCTIONAL_TEST&apos;,encryptedKeyBlock:row.encrypted_key_block]))
        SampleResult.setResponseData(&apos;Prepared opaque wrapped successor from this run; key material is not printed.&apos;,&apos;UTF-8&apos;)
    } finally { db.close() }
} catch (Exception | AssertionError failure) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;CLIENT_CONFIGURATION_FAILED&apos;)
    SampleResult.setResponseMessage(failure.message ?: &apos;Client configuration assertion failed&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
}</stringProp>
