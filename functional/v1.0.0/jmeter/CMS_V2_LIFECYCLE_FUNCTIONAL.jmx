            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="The shared account lists exactly the two cards" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    def items = data.content
    assert items?.size() == 2 : &apos;Expected 2 cards on the shared account, found &apos; + (items?.size())
    def ids = items.collect { it.cardId } as Set
    assert ids == [vars.get(&apos;CARD_B1&apos;), vars.get(&apos;CARD_B2&apos;)] as Set : &apos;Listed cards are &apos; + ids
    def pans = items.collect { it.maskedPan } as Set
    assert pans.size() == 2 : &apos;Two cards on one account share a masked PAN: &apos; + pans
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Shared-account listing was not as expected&apos;)
}</stringProp>
