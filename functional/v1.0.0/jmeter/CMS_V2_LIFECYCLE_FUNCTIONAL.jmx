          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="26.1.3 - Require issued card: A08 live card" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;STATUS_CARD_Z&apos;) != &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_NOT_CONFIRMED&apos;)
    SampleResult.setResponseMessage(&apos;A08 live card did not reach CONFIRMED: status=&apos; + vars.get(&apos;STATUS_CARD_Z&apos;) +
        &apos;; operation=&apos; + vars.get(&apos;OP_CARD_Z&apos;) + &apos;; polls=&apos; + vars.get(&apos;POLL_CARD_Z&apos;) +
        &apos;; UNKNOWN observed &apos; + vars.get(&apos;UNKNOWN_CARD_Z&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;A08 live card card &apos; + vars.get(&apos;CARD_Z&apos;), &apos;UTF-8&apos;)
}</stringProp>
