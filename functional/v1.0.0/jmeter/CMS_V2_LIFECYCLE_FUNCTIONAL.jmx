            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">try {
    assert prev.responseCode == &apos;401&apos; : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == false : &apos;Rejection did not return a failure envelope&apos;
    assert (envelope.error?.code ?: envelope.errorCode) in [&apos;UNAUTHENTICATED&apos;, &apos;INVALID_TOKEN&apos;] : &apos;Error code is &apos; + (envelope.error?.code ?: envelope.errorCode)
    assert !prev.responseDataAsString.contains(&apos;maskedPan&apos;) : &apos;An unauthenticated rejection leaked card data&apos;
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;An unauthenticated read was served&apos;)
}</stringProp>
