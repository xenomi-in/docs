            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="approve pending implementation" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    def message = (envelope.error?.message ?: &apos;&apos;).toString()
    if (prev.responseCode == &apos;422&apos; &amp;&amp; message.toLowerCase().contains(&apos;implementation pending&apos;)) return
    if (prev.responseCode == &apos;404&apos;) return
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;Expected stub or 404 for approve, got HTTP &apos; + prev.responseCode + &apos;: &apos; + message)
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;approve behaved unexpectedly&apos;)
}</stringProp>
