            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="01.12 - Seed card vendor and personalisation batch" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.sql.Sql
try {
    assert vars.get(&apos;ALLOW_TEST_FIXTURES&apos;) == &apos;true&apos;
    def db = Sql.newInstance(vars.get(&apos;DB_URL&apos;), vars.get(&apos;DB_USERNAME&apos;), vars.get(&apos;DB_PASSWORD&apos;), &apos;org.postgresql.Driver&apos;)
    try {
        db.withTransaction {
            def suffix = vars.get(&apos;RUN_SUFFIX&apos;)
            assert db.executeUpdate(&quot;insert into cms_v2.card_vendor(vendor_id,institution_id,vendor_code,vendor_name,vendor_status) values(?::uuid,?::uuid,?,&apos;Lifecycle vendor&apos;,&apos;ACTIVE&apos;)&quot;, [vars.get(&apos;VENDOR_ID&apos;), vars.get(&apos;INSTITUTION_ID&apos;), &apos;LFV-&apos; + suffix]) == 1
            assert db.executeUpdate(&quot;insert into cms_v2.personalisation_batch_configuration(batch_configuration_id,institution_id,vendor_id,configuration_code,configuration_status,created_by,updated_by) values(?::uuid,?::uuid,?::uuid,?,&apos;ACTIVE&apos;,&apos;jmeter-lf&apos;,&apos;jmeter-lf&apos;)&quot;, [vars.get(&apos;BATCH_CONFIG_ID&apos;), vars.get(&apos;INSTITUTION_ID&apos;), vars.get(&apos;VENDOR_ID&apos;), &apos;LFB-&apos; + suffix]) == 1
        }
    } finally { db.close() }
    SampleResult.setResponseData(&apos;Seeded vendor &apos; + vars.get(&apos;VENDOR_ID&apos;) + &apos; batch &apos; + vars.get(&apos;BATCH_CONFIG_ID&apos;), &apos;UTF-8&apos;)
} catch (Exception | AssertionError failure) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;FIXTURE_ERROR&apos;)
    SampleResult.setResponseMessage(failure.message ?: &apos;Could not seed vendor/batch fixtures&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
}</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
            </JSR223Sampler>
