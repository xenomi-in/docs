        &apos;; operation=&apos; + vars.get(&apos;OP_CARD_VO2&apos;) + &apos;; polls=&apos; + vars.get(&apos;POLL_CARD_VO2&apos;) +
        &apos;; UNKNOWN observed &apos; + vars.get(&apos;UNKNOWN_CARD_VO2&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
