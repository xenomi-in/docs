            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Customer-selected issuance enrolls a Switch PIN that is not yet established" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.cardId == vars.get(&apos;CARD_PIN&apos;)
    assert data.authority == &apos;SWITCH&apos; : &apos;authority is &apos; + data.authority + &apos;; Switch PIN integration must be enabled for new issuance&apos;
    assert data.pinStatus == &apos;RESET_REQUIRED&apos; : &apos;pinStatus is &apos; + data.pinStatus
    assert data.pinRequired == true
    assert (data.lastConfirmedPinVersion ?: 0) == 0 : &apos;A new family must not already have a confirmed PIN version&apos;
    assert data.liveSwitchState == false
    assert !prev.responseDataAsString.toLowerCase().contains(&apos;encryptedpinblock&apos;)
    assert !prev.responseDataAsString.toLowerCase().contains(&apos;pinoffset&apos;)
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;PIN state was not a Switch-enrolled, unestablished family&apos;)
}</stringProp>
