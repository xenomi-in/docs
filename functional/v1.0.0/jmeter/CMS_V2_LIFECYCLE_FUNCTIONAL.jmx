            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="19.12.0 - Reset Switch poll counters: Q08 successor registration" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">vars.put(&apos;SYNC_SUCC_Q&apos;, &apos;false&apos;)
vars.put(&apos;SYNCPOLL_SUCC_Q&apos;, &apos;0&apos;)
vars.put(&apos;SYNC_FAILED_SUCC_Q&apos;, &apos;false&apos;)</stringProp>
