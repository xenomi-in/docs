          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="12.11.1 - Submit issuance: C05 first card at the ceiling" enabled="true">
            <intProp name="HTTPSampler.connect_timeout">10000</intProp>
            <intProp name="HTTPSampler.response_timeout">90000</intProp>
            <stringProp name="HTTPSampler.domain">${CMS_HOST}</stringProp>
            <stringProp name="HTTPSampler.port">${CMS_PORT}</stringProp>
            <stringProp name="HTTPSampler.protocol">${CMS_PROTOCOL}</stringProp>
            <stringProp name="HTTPSampler.path">/cms/api/v2/institutions/${INSTITUTION_ID}/cards</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">${BODY_CARD_CEIL}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Headers" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="Idempotency-Key" elementType="Header">
                  <stringProp name="Header.name">Idempotency-Key</stringProp>
                  <stringProp name="Header.value">${KEY_CARD_CEIL}</stringProp>
                </elementProp>
                <elementProp name="X-Request-Id" elementType="Header">
                  <stringProp name="Header.name">X-Request-Id</stringProp>
                  <stringProp name="Header.value">${KEY_CARD_CEIL}-req</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Issuance accepted" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode == &apos;202&apos; : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.operationId
    vars.put(&apos;OP_CARD_CEIL&apos;, data.operationId.toString())
    vars.put(&apos;STATUS_CARD_CEIL&apos;, data.status.toString())
    if (data.status == &apos;CONFIRMED&apos;) {
        vars.put(&apos;CARD_CEIL&apos;, data.result.cards[0].cardId.toString())
        vars.put(&apos;CONT_CARD_CEIL&apos;, &apos;false&apos;)
    } else if (data.status == &apos;FAILED&apos;) {
        vars.put(&apos;CONT_CARD_CEIL&apos;, &apos;false&apos;)
    }
} catch (Exception | AssertionError failure) {
    vars.put(&apos;CONT_CARD_CEIL&apos;, &apos;false&apos;)
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Issuance submit failed&apos;)
}</stringProp>
