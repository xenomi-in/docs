          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="30.14 - Remaining PIN cases need a Switch-accepted PIN" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">SampleResult.setResponseData(
    &apos;CMS rules covered here: metadata reads, request validation, change versus reset shape, &apos; +
    &apos;refusal before a PIN is established, and refusal on a lost or closed card. &apos; +
    &apos;A completed initialize, change, or reset, a wrong current PIN, the attempt limit, and a PIN block &apos; +
    &apos;are decided by Switch from a real ISO-0 block and an issuer authorization grant. This plan does not invent that block.&apos;,
    &apos;UTF-8&apos;)</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223Sampler>
