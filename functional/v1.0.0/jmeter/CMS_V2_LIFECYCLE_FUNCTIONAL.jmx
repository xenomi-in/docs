            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">vars.put(&apos;BODY_CLIENT_CARD_C&apos;, groovy.json.JsonOutput.toJson([
    customerReferenceId: vars.get(&apos;CUSTOMER_REFERENCE_ID&apos;),
    accountReferenceId: vars.get(&apos;CLIENT_ACCOUNT_3&apos;),
    productId: vars.get(&apos;CLIENT_OTHER_PRODUCT&apos;),
    productVersionId: vars.get(&apos;CLIENT_OTHER_VERSION&apos;),
    binRangeId: vars.get(&apos;BIN_RANGE_ID&apos;),
    activationPolicyVersionId: vars.get(&apos;ACTIVATION_POLICY_VERSION_ID&apos;),
    accountLinkType: &apos;PRIMARY_FUNDING&apos;,
    embossedNameLine1: &apos;LF CLIENT CARD C&apos;
]))
vars.put(&apos;KEY_CLIENT_CARD_C&apos;, vars.get(&apos;RUN_ID&apos;) + &apos;-client-card-c&apos;)
vars.put(&apos;POLL_CLIENT_CARD_C&apos;, &apos;0&apos;)
vars.put(&apos;CONT_CLIENT_CARD_C&apos;, &apos;true&apos;)
vars.put(&apos;STATUS_CLIENT_CARD_C&apos;, &apos;PENDING&apos;)
vars.put(&apos;UNKNOWN_CLIENT_CARD_C&apos;, &apos;0&apos;)</stringProp>
