          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="29.3.4.3 - Require completed replacement: LOST new-PAN security replacement" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def successor = vars.get(&apos;SUCC_LOST&apos;)
if (!(vars.get(&apos;RSTATUS_SUCC_LOST&apos;) in [&apos;CONFIRMED&apos;, &apos;COMPLETED&apos;]) || !successor || successor == &apos;NOT_FOUND&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;REPLACEMENT_NOT_COMPLETED&apos;)
    SampleResult.setResponseMessage(&apos;LOST new-PAN security replacement status=&apos; + vars.get(&apos;RSTATUS_SUCC_LOST&apos;) + &apos;; request=&apos; + vars.get(&apos;RREQ_SUCC_LOST&apos;) +
        &apos;; polls=&apos; + vars.get(&apos;RPOLL_SUCC_LOST&apos;) + &apos;; UNKNOWN observed &apos; + vars.get(&apos;RUNKNOWN_SUCC_LOST&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;LOST new-PAN security replacement successor &apos; + successor + &apos; (resolved PAN strategy &apos; +
        (vars.get(&apos;RRESOLVED_SUCC_LOST&apos;) ?: &apos;not reported&apos;) + &apos;)&apos;, &apos;UTF-8&apos;)
}</stringProp>
