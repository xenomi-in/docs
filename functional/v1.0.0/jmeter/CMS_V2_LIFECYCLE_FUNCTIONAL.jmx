          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="28.9 - Prepare issuance: later card for block" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">vars.put(&apos;BODY_CARD_LATER3&apos;, groovy.json.JsonOutput.toJson([
    customerReferenceId: vars.get(&apos;CUSTOMER_REFERENCE_ID&apos;),
    accountReferenceId: vars.get(&apos;ACCOUNT_REF_27&apos;),
    productId: vars.get(&apos;PHYS_LATER_PRODUCT_ID&apos;),
    productVersionId: vars.get(&apos;PHYS_LATER_VERSION_ID&apos;),
    binRangeId: vars.get(&apos;BIN_RANGE_ID&apos;),
    activationPolicyVersionId: vars.get(&apos;ACTIVATION_POLICY_VERSION_ID&apos;),
    accountLinkType: &apos;PRIMARY_FUNDING&apos;,
    embossedNameLine1: &apos;LF later card for block&apos;, shippingAddressReferenceId: vars.get(&apos;ADDRESS_REF_ID&apos;)
]))
vars.put(&apos;KEY_CARD_LATER3&apos;, vars.get(&apos;RUN_ID&apos;) + &apos;-later3&apos;)
vars.put(&apos;POLL_CARD_LATER3&apos;, &apos;0&apos;)
vars.put(&apos;CONT_CARD_LATER3&apos;, &apos;true&apos;)
vars.put(&apos;STATUS_CARD_LATER3&apos;, &apos;PENDING&apos;)
vars.put(&apos;UNKNOWN_CARD_LATER3&apos;, &apos;0&apos;)</stringProp>
