            <stringProp name="script">def successor = vars.get(&apos;SUCC_K1&apos;)
if (!(vars.get(&apos;RSTATUS_SUCC_K1&apos;) in [&apos;CONFIRMED&apos;, &apos;COMPLETED&apos;]) || !successor || successor == &apos;NOT_FOUND&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;REPLACEMENT_NOT_COMPLETED&apos;)
    SampleResult.setResponseMessage(&apos;K09 first renewal status=&apos; + vars.get(&apos;RSTATUS_SUCC_K1&apos;) + &apos;; request=&apos; + vars.get(&apos;RREQ_SUCC_K1&apos;) +
        &apos;; polls=&apos; + vars.get(&apos;RPOLL_SUCC_K1&apos;) + &apos;; UNKNOWN observed &apos; + vars.get(&apos;RUNKNOWN_SUCC_K1&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;K09 first renewal successor &apos; + successor + &apos; (resolved PAN strategy &apos; +
        (vars.get(&apos;RRESOLVED_SUCC_K1&apos;) ?: &apos;not reported&apos;) + &apos;)&apos;, &apos;UTF-8&apos;)
