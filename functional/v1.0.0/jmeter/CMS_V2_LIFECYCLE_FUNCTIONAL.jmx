            <stringProp name="script">vars.put(&apos;BODY_B02C&apos;, groovy.json.JsonOutput.toJson([customerReferenceId: &apos;00000000-0000-4000-8000-0000000000c1&apos;, accountReferenceId: vars.get(&apos;ACCOUNT_REF_4&apos;), productId: vars.get(&apos;PRODUCT_ID&apos;), productVersionId: vars.get(&apos;PRODUCT_VERSION_ID&apos;), binRangeId: vars.get(&apos;BIN_RANGE_ID&apos;), activationPolicyVersionId: vars.get(&apos;ACTIVATION_POLICY_VERSION_ID&apos;), accountLinkType: &apos;PRIMARY_FUNDING&apos;, embossedNameLine1: &apos;LF NEGATIVE&apos;]))
