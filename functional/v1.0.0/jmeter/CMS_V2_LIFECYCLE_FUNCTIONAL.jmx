            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Predecessor and successor are both recorded with the reason" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.sourceCardId == vars.get(&apos;CARD_T&apos;) : &apos;The record points at source &apos; + data.sourceCardId
    assert data.replacementCardId == vars.get(&apos;SUCC_T&apos;) : &apos;The record points at successor &apos; + data.replacementCardId
    assert data.replacementReason == &apos;RENEWAL&apos; : &apos;The recorded reason is &apos; + data.replacementReason
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;The replacement record did not link both generations&apos;)
}</stringProp>
