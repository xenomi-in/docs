              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Zero has defined semantics" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">try {
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    if (prev.responseCode == &apos;200&apos;) {
        def selected = envelope.data.controls.find { it.geography == &apos;DOMESTIC&apos; &amp;&amp; it.channel == &apos;ECOM&apos; }
        assert selected.perTransactionLimitMinor == 0 :
            &apos;A zero limit was accepted but stored as &apos; + selected.perTransactionLimitMinor + &apos;; zero must not be silently treated as unset&apos;
        vars.put(&apos;I04_OUTCOME&apos;, &apos;zero accepted and stored&apos;)
    } else {
        assert prev.responseCode.startsWith(&apos;4&apos;) : &apos;Unexpected HTTP status: &apos; + prev.responseCode
        assert envelope.success == false
        vars.put(&apos;I04_OUTCOME&apos;, &apos;zero refused with HTTP &apos; + prev.responseCode)
    }
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Zero-limit semantics are ambiguous&apos;)
}</stringProp>
