              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Capture replacement status" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">try {
    vars.put(&apos;RPOLL_SUCC_Q&apos;, (Integer.parseInt(vars.get(&apos;RPOLL_SUCC_Q&apos;)) + 1).toString())
    if (Integer.parseInt(vars.get(&apos;RPOLL_SUCC_Q&apos;)) &gt;= Integer.parseInt(vars.get(&apos;MAX_POLLS&apos;))) {
        vars.put(&apos;RCONT_SUCC_Q&apos;, &apos;false&apos;)
    }
    if (prev.responseCode == &apos;404&apos;) return
    assert prev.responseCode == &apos;200&apos; : &apos;Unexpected HTTP status: &apos; + prev.responseCode
    def data = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString).data
    def status = (data.operationStatus ?: data.requestStatus)?.toString()
    vars.put(&apos;RSTATUS_SUCC_Q&apos;, status ?: &apos;PENDING&apos;)
    if (data.replacementCardId) vars.put(&apos;SUCC_Q&apos;, data.replacementCardId.toString())
    if (data.resolvedPanStrategy) vars.put(&apos;RRESOLVED_SUCC_Q&apos;, data.resolvedPanStrategy.toString())
    if (data.sourceCardStatus) vars.put(&apos;RSOURCE_SUCC_Q&apos;, data.sourceCardStatus.toString())
    if (status == &apos;UNKNOWN&apos;) {
        vars.put(&apos;RUNKNOWN_SUCC_Q&apos;, (Integer.parseInt(vars.get(&apos;RUNKNOWN_SUCC_Q&apos;)) + 1).toString())
    }
    if (status in [&apos;CONFIRMED&apos;, &apos;COMPLETED&apos;, &apos;FAILED&apos;, &apos;REJECTED&apos;]) vars.put(&apos;RCONT_SUCC_Q&apos;, &apos;false&apos;)
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Replacement poll failed&apos;)
}</stringProp>
