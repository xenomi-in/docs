          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="15.1.3 - Require issued card: I limits card" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;STATUS_CARD_I&apos;) != &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_NOT_CONFIRMED&apos;)
    SampleResult.setResponseMessage(&apos;I limits card did not reach CONFIRMED: status=&apos; + vars.get(&apos;STATUS_CARD_I&apos;) +
        &apos;; operation=&apos; + vars.get(&apos;OP_CARD_I&apos;) + &apos;; polls=&apos; + vars.get(&apos;POLL_CARD_I&apos;) +
        &apos;; UNKNOWN observed &apos; + vars.get(&apos;UNKNOWN_CARD_I&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;I limits card card &apos; + vars.get(&apos;CARD_I&apos;), &apos;UTF-8&apos;)
}</stringProp>
