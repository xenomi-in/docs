              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert (data.controlVersion as int) == Integer.parseInt(vars.get(&apos;H_INTL_VERSION&apos;)) + 1 : &apos;controlVersion is &apos; + data.controlVersion
    def enabled = data.controls.findAll { it.enabled == true }.collect { it.geography + &apos;/&apos; + it.channel } as Set
    assert enabled == [&apos;DOMESTIC/POS_CONTACT&apos;, &apos;INTERNATIONAL/ATM&apos;] as Set : &apos;Enabled dimensions are &apos; + enabled
    vars.put(&apos;H_ONE_VERSION&apos;, data.controlVersion.toString())
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;A single-dimension update did not preserve the others&apos;)
}</stringProp>
