    binRangeId: vars.get(&apos;BIN_RANGE_ID&apos;),
    activationPolicyVersionId: vars.get(&apos;ACTIVATION_POLICY_VERSION_ID&apos;),
    accountLinkType: &apos;PRIMARY_FUNDING&apos;,
    embossedNameLine1: &apos;LF CLIENT CARD A&apos;, shippingAddressReferenceId: vars.get(&apos;ADDRESS_REF_ID&apos;), productionBatchConfigurationId: vars.get(&apos;BATCH_CONFIG_ID&apos;)
]))
vars.put(&apos;KEY_CLIENT_CARD_A&apos;, vars.get(&apos;RUN_ID&apos;) + &apos;-client-card-a&apos;)
vars.put(&apos;POLL_CLIENT_CARD_A&apos;, &apos;0&apos;)
vars.put(&apos;CONT_CLIENT_CARD_A&apos;, &apos;true&apos;)
vars.put(&apos;STATUS_CLIENT_CARD_A&apos;, &apos;PENDING&apos;)
vars.put(&apos;UNKNOWN_CLIENT_CARD_A&apos;, &apos;0&apos;)</stringProp>
