          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="28.5.3 - Require issued card: later card for close" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;STATUS_CARD_LATER2&apos;) != &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_NOT_CONFIRMED&apos;)
    SampleResult.setResponseMessage(&apos;later card for close did not reach CONFIRMED: status=&apos; + vars.get(&apos;STATUS_CARD_LATER2&apos;) +
        &apos;; operation=&apos; + vars.get(&apos;OP_CARD_LATER2&apos;) + &apos;; polls=&apos; + vars.get(&apos;POLL_CARD_LATER2&apos;) +
        &apos;; UNKNOWN observed &apos; + vars.get(&apos;UNKNOWN_CARD_LATER2&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;later card for close card &apos; + vars.get(&apos;CARD_LATER2&apos;), &apos;UTF-8&apos;)
}</stringProp>
