              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Capture issuance status" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">try {
    vars.put(&apos;POLL_CARD_K&apos;, (Integer.parseInt(vars.get(&apos;POLL_CARD_K&apos;)) + 1).toString())
    assert prev.responseCode == &apos;200&apos; : &apos;Unexpected HTTP status: &apos; + prev.responseCode
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    vars.put(&apos;STATUS_CARD_K&apos;, data.status.toString())
    if (data.status == &apos;UNKNOWN&apos;) {
        vars.put(&apos;UNKNOWN_CARD_K&apos;, (Integer.parseInt(vars.get(&apos;UNKNOWN_CARD_K&apos;)) + 1).toString())
    }
    if (data.status == &apos;CONFIRMED&apos;) {
        assert data.result.cards.size() == 1
        vars.put(&apos;CARD_K&apos;, data.result.cards[0].cardId.toString())
        vars.put(&apos;CONT_CARD_K&apos;, &apos;false&apos;)
    } else if (data.status == &apos;FAILED&apos;) {
        vars.put(&apos;CONT_CARD_K&apos;, &apos;false&apos;)
    }
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Issuance poll failed&apos;)
}</stringProp>
