    def message = (envelope.error?.message ?: &apos;&apos;).toString()
    assert message.contains(&apos;Replacement is disabled by the active product policy&apos;) : message
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;A disallowed replacement reason is refused&apos;)
