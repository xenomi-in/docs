    assert missing.isEmpty() : &apos;Bootstrap did not produce: &apos; + missing
    SampleResult.setResponseData(&apos;Published &apos; + 92 + &apos; shared identifiers for institution &apos; + vars.get(&apos;INSTITUTION_ID&apos;), &apos;UTF-8&apos;)
