          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="06b - Seed restriction snapshots, activation policy and policy activations" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.sql.Sql
def fixtureStage = &apos;validate disposable database configuration&apos;
try {
    assert vars.get(&apos;ALLOW_TEST_FIXTURES&apos;) == &apos;true&apos;
    def databaseMatch = (vars.get(&apos;DB_URL&apos;) ?: &apos;&apos;) =~ /^jdbc:postgresql:\/\/[^\/]+\/([^?\/]+)(?:\?.*)?$/
    if (!vars.get(&apos;EXPECTED_TEST_DATABASE&apos;)?.trim() || !databaseMatch.matches() || databaseMatch.group(1) != vars.get(&apos;EXPECTED_TEST_DATABASE&apos;)) {
        throw new IllegalArgumentException(&apos;DB_URL must target EXPECTED_TEST_DATABASE (database name, not schema name)&apos;)
    }
    fixtureStage = &apos;require customer-service UUIDs&apos;
    assert vars.get(&apos;CUSTOMER_REFERENCE_ID&apos;) &amp;&amp; vars.get(&apos;CUSTOMER_REFERENCE_ID&apos;) != &apos;NOT_FOUND&apos; : &apos;CUSTOMER_REFERENCE_ID was not returned by customer-service&apos;
    assert vars.get(&apos;SECOND_CUSTOMER_REFERENCE_ID&apos;) &amp;&amp; vars.get(&apos;SECOND_CUSTOMER_REFERENCE_ID&apos;) != &apos;NOT_FOUND&apos; : &apos;SECOND_CUSTOMER_REFERENCE_ID was not returned by customer-service&apos;
    assert vars.get(&apos;ADDRESS_REF_ID&apos;) &amp;&amp; vars.get(&apos;ADDRESS_REF_ID&apos;) != &apos;NOT_FOUND&apos; : &apos;ADDRESS_REF_ID was not returned by customer-service&apos;
    (1..40).each { index -&gt;
        def accountId = vars.get(&apos;ACCOUNT_REF_&apos; + index)
        assert accountId &amp;&amp; accountId != &apos;NOT_FOUND&apos; : &apos;ACCOUNT_REF_&apos; + index + &apos; was not returned by customer-service&apos;
    }
    fixtureStage = &apos;connect to database&apos;
    def db = Sql.newInstance(vars.get(&apos;DB_URL&apos;), vars.get(&apos;DB_USERNAME&apos;), vars.get(&apos;DB_PASSWORD&apos;), &apos;org.postgresql.Driver&apos;)
    def tenant = vars.get(&apos;INSTITUTION_ID&apos;)
    def suffix = vars.get(&apos;RUN_SUFFIX&apos;)
    try {
        db.withTransaction {
            fixtureStage = &apos;verify institution created by this run&apos;
            assert db.firstRow(&apos;select institution_id from cms_v2.institution where institution_id=?::uuid&apos;, [tenant])
            fixtureStage = &apos;insert account restriction snapshots&apos;
            (1..40).each { index -&gt;
                def accountId = vars.get(&apos;ACCOUNT_REF_&apos; + index)
                assert db.executeUpdate(&quot;insert into cms_v2.account_restriction_snapshot(institution_id,account_reference_id,source_version,observed_at,valid_until,evidence_reference) values(?::uuid,?::uuid,1,now(),now()+interval &apos;6 hours&apos;,&apos;LF-NO-HOLDS&apos;)&quot;, [tenant, accountId]) == 1
            }
            fixtureStage = &apos;create disposable activation policy fixture&apos;
            assert db.executeUpdate(&quot;insert into cms_v2.activation_policy_version(activation_policy_version_id,institution_id,policy_reference,version,calendar_reference,expiry_timezone,policy_document_reference,effective_from) values(?::uuid,?::uuid,?,1,&apos;LF-TEST-CALENDAR&apos;,&apos;Asia/Kolkata&apos;,&apos;LF-DISPOSABLE-FIXTURE-NOT-PRODUCTION-APPROVAL&apos;,now()-interval &apos;1 minute&apos;)&quot;, [vars.get(&apos;ACTIVATION_POLICY_VERSION_ID&apos;), tenant, &apos;LF-ACTIVATION-&apos; + suffix]) == 1
            fixtureStage = &apos;activate draft PIN policies&apos;
            def versionIds = [&apos;PRODUCT_VERSION_ID&apos;, &apos;CEILING_PRODUCT_VERSION_ID&apos;, &apos;DRAFT_PRODUCT_VERSION_ID&apos;,
                &apos;PHYS_LATER_VERSION_ID&apos;, &apos;PHYS_ONLY_VERSION_ID&apos;, &apos;SAME_DAY_VERSION_ID&apos;, &apos;MULTI_VERSION_ID&apos;].collect { vars.get(it) }
            assert versionIds.every { it &amp;&amp; it != &apos;NOT_FOUND&apos; } : &apos;Run product version identifiers are required&apos;
            def versionPlaceholders = versionIds.collect { &apos;?::uuid&apos; }.join(&apos;,&apos;)
            def policyParameters = [tenant] + versionIds
            def pinRows = db.executeUpdate(&quot;update cms_v2.product_pin_policy set policy_status=&apos;ACTIVE&apos; where institution_id=?::uuid and product_version_id in (&quot; + versionPlaceholders + &quot;) and policy_status=&apos;DRAFT&apos;&quot;, policyParameters)
            assert pinRows &gt;= 1 : &apos;No DRAFT PIN policy was activated&apos;
            fixtureStage = &apos;activate draft personalisation policies&apos;
            db.executeUpdate(&quot;update cms_v2.product_personalisation_policy set policy_status=&apos;ACTIVE&apos; where institution_id=?::uuid and product_version_id in (&quot; + versionPlaceholders + &quot;) and policy_status=&apos;DRAFT&apos;&quot;, policyParameters)
            fixtureStage = &apos;activate draft replacement policies&apos;
            def replacementRows = db.executeUpdate(&quot;update cms_v2.product_replacement_policy set policy_status=&apos;ACTIVE&apos; where institution_id=?::uuid and product_version_id=?::uuid and policy_status=&apos;DRAFT&apos;&quot;, [tenant, vars.get(&apos;PRODUCT_VERSION_ID&apos;)])
            assert replacementRows == 6 : &apos;Expected 6 replacement policies to activate, updated &apos; + replacementRows
            fixtureStage = &apos;map the Switch PIN profile for this institution&apos;
            db.executeUpdate(&quot;insert into cms_v2.switch_pin_profile_mapping(institution_id, profile_reference, key_binding_reference) select ?::uuid, &apos;LF-PIN-PROFILE&apos;, &apos;lf.visa.pvk.v1&apos; where not exists (select 1 from cms_v2.switch_pin_profile_mapping where institution_id=?::uuid and profile_reference=&apos;LF-PIN-PROFILE&apos;)&quot;, [tenant, tenant])
            assert db.firstRow(&quot;select 1 from cms_v2.switch_pin_profile_mapping where institution_id=?::uuid and profile_reference=&apos;LF-PIN-PROFILE&apos;&quot;, [tenant])
            fixtureStage = &apos;commit fixture transaction&apos;
        }
    } finally { db.close() }
    SampleResult.setResponseData(&apos;DB fixtures created (restriction snapshots, activation policy, policy activations, Switch PIN profile mapping); customer/account/address came from customer-service.&apos;, &apos;UTF-8&apos;)
} catch (Exception | AssertionError failure) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;FIXTURE_ERROR&apos;)
    def cause = failure
    while (cause.cause != null &amp;&amp; cause.cause != cause) { cause = cause.cause }
    def sqlState = cause instanceof java.sql.SQLException ? cause.SQLState : &apos;not available&apos;
    SampleResult.setResponseMessage(&apos;Fixture setup failed at: &apos; + fixtureStage + &apos;; SQLState=&apos; + sqlState + &apos;; error=&apos; + (failure.message ?: cause.class.simpleName))
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
}</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223Sampler>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="07 - Publish shared configuration to later thread groups" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">try {
    def missing = []
