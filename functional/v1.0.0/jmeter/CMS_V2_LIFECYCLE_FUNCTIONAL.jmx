            <stringProp name="WhileController.condition">${__groovy(vars.get(&apos;CONT_B02C&apos;) == &apos;true&apos; &amp;&amp; Integer.parseInt(vars.get(&apos;POLL_B02C&apos;)) &lt; Integer.parseInt(vars.get(&apos;MAX_POLLS&apos;)))}</stringProp>
          </WhileController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="11.1.2a - Read rejected issuance operation: B02 unknown customer reference" enabled="true">
              <intProp name="HTTPSampler.connect_timeout">10000</intProp>
              <intProp name="HTTPSampler.response_timeout">45000</intProp>
              <stringProp name="HTTPSampler.domain">${CMS_HOST}</stringProp>
