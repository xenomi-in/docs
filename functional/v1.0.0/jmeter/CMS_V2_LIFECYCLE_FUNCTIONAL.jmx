          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="16.6 - J05 The successor preserves the PAN and the account linkage" enabled="true">
            <intProp name="HTTPSampler.connect_timeout">10000</intProp>
            <intProp name="HTTPSampler.response_timeout">45000</intProp>
            <stringProp name="HTTPSampler.domain">${CMS_HOST}</stringProp>
            <stringProp name="HTTPSampler.port">${CMS_PORT}</stringProp>
            <stringProp name="HTTPSampler.protocol">${CMS_PROTOCOL}</stringProp>
            <stringProp name="HTTPSampler.path">/cms/api/v2/institutions/${INSTITUTION_ID}/cards/${SUCC_J1}</stringProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments">
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Expected HTTP 2\d\d" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49015874">2\d\d</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">Expected HTTP 2\d\d</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">1</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="PRESERVE_EXISTING_PAN kept the credential and the relationships" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.cardId != vars.get(&apos;CARD_J1&apos;) : &apos;The replacement returned the source card as its own successor&apos;
    assert data.maskedPan == vars.get(&apos;J1_PAN&apos;) : &apos;The same-PAN replacement changed the PAN to &apos; + data.maskedPan
    assert data.expiryDate.toString() != vars.get(&apos;J1_EXPIRY&apos;) : &apos;A renewal must move the expiry out; it is still &apos; + data.expiryDate
    assert data.cardStatus == &apos;PENDING&apos; : &apos;A replacement card must be activated before use; it is &apos; + data.cardStatus
    assert data.accountReferenceId == vars.get(&apos;ACCOUNT_REF_12&apos;) : &apos;The successor lost the account linkage&apos;
    assert data.customerReferenceId == vars.get(&apos;CUSTOMER_REFERENCE_ID&apos;)
    assert data.lifecycleVersion == 1 : &apos;Successor lifecycleVersion is &apos; + data.lifecycleVersion
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;The successor was not as configured&apos;)
}</stringProp>
