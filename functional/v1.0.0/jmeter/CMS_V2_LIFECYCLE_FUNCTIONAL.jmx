          <hashTree>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="14.10.0 - Reset Switch poll counters: controls enabled" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">vars.put(&apos;SYNC_CARD_H&apos;, &apos;false&apos;)
vars.put(&apos;SYNCPOLL_CARD_H&apos;, &apos;0&apos;)
vars.put(&apos;SYNC_FAILED_CARD_H&apos;, &apos;false&apos;)</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
            </JSR223Sampler>
