              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="The stored limit is still the ceiling" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    def selected = data.controls.find { it.geography == &apos;DOMESTIC&apos; &amp;&amp; it.channel == &apos;ECOM&apos; }
    def ceiling = Long.parseLong(vars.get(&apos;LIMIT_AT_CEILING&apos;))
    assert selected.perTransactionLimitMinor == ceiling : &apos;The stored limit is now &apos; + selected.perTransactionLimitMinor
    assert data.controlVersion.toString() == vars.get(&apos;I_AT_CEILING_VERSION&apos;) : &apos;A refused limit advanced controlVersion to &apos; + data.controlVersion
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;A refused limit changed the stored value&apos;)
}</stringProp>
