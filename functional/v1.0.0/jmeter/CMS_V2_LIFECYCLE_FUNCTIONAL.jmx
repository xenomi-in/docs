            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Same PAN, later expiry, fresh lifecycle" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.maskedPan == vars.get(&apos;K_PAN&apos;) : &apos;The renewal changed the PAN to &apos; + data.maskedPan
    def before = java.time.LocalDate.parse(vars.get(&apos;K_EXPIRY_1&apos;))
    def after = java.time.LocalDate.parse(data.expiryDate.toString())
    assert after.isAfter(before) : &apos;Generation two expires &apos; + after + &apos;, which is not after &apos; + before
    assert after == after.withDayOfMonth(after.lengthOfMonth()) : &apos;END_OF_EXPIRY_MONTH should land on the last day of the month, got &apos; + after
    assert data.cardStatus == &apos;PENDING&apos;
    vars.put(&apos;K_EXPIRY_2&apos;, data.expiryDate.toString())
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Generation two was not as configured&apos;)
}</stringProp>
