              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Verify tenancy is enforced on reads" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">try {
    assert prev.responseCode == &apos;403&apos; : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == false : &apos;Rejection did not return a failure envelope&apos;
    def errorCode = envelope.error?.code ?: envelope.errorCode
    assert errorCode in [&apos;TENANT_ACCESS_DENIED&apos;, &apos;ACCESS_DENIED&apos;] : &apos;Error code is &apos; + errorCode
    assert !prev.responseDataAsString.contains(&apos;maskedPan&apos;) : &apos;A cross-tenant rejection leaked card data&apos;
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;One institution read another institution\&apos;s cards&apos;)
}</stringProp>
