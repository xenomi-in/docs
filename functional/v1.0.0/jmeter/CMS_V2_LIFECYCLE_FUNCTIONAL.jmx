            <stringProp name="WhileController.condition">${__groovy(vars.get(&apos;CONT_B02A&apos;) == &apos;true&apos; &amp;&amp; Integer.parseInt(vars.get(&apos;POLL_B02A&apos;)) &lt; Integer.parseInt(vars.get(&apos;MAX_POLLS&apos;)))}</stringProp>
          </WhileController>
