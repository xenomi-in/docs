            <stringProp name="script">vars.put(&apos;BODY_MULTI&apos;, groovy.json.JsonOutput.toJson([customerReferenceId: vars.get(&apos;CUSTOMER_REFERENCE_ID&apos;), accountReferenceId: vars.get(&apos;ACCOUNT_REF_30&apos;), productId: vars.get(&apos;MULTI_PRODUCT_ID&apos;), productVersionId: vars.get(&apos;MULTI_VERSION_ID&apos;), binRangeId: vars.get(&apos;BIN_RANGE_ID&apos;), activationPolicyVersionId: vars.get(&apos;ACTIVATION_POLICY_VERSION_ID&apos;), accountLinkType: &apos;PRIMARY_FUNDING&apos;, embossedNameLine1: &apos;LF NEGATIVE&apos;, shippingAddressReferenceId: vars.get(&apos;ADDRESS_REF_ID&apos;), productionBatchConfigurationId: vars.get(&apos;BATCH_CONFIG_ID&apos;), cardDesignId: vars.get(&apos;PHYSICAL_DESIGN_ID&apos;)]))
vars.put(&apos;KEY_MULTI&apos;, vars.get(&apos;RUN_ID&apos;) + &apos;-multi-ceil&apos;)
vars.put(&apos;POLL_MULTI&apos;, &apos;0&apos;)
vars.put(&apos;CONT_MULTI&apos;, &apos;unset&apos;)
