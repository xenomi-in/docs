            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Successor is a distinct pending card on a new PAN" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.cardId == vars.get(&apos;SUCC_LOST&apos;)
    assert data.cardId != vars.get(&apos;CARD_RB&apos;) : &apos;Replacement returned the source as its successor&apos;
    assert data.maskedPan != vars.get(&apos;CARD_RB_PAN&apos;) : &apos;Successor kept the source PAN &apos; + data.maskedPan
    assert data.cardStatus == &apos;PENDING&apos; : &apos;successor cardStatus is &apos; + data.cardStatus
    assert data.accountReferenceId == vars.get(&apos;ACCOUNT_REF_31&apos;) : &apos;Successor lost the account link&apos;
    assert data.customerReferenceId == vars.get(&apos;CUSTOMER_REFERENCE_ID&apos;)
    assert vars.get(&apos;RRESOLVED_SUCC_LOST&apos;) == &apos;GENERATE_NEW_PAN&apos; : &apos;resolvedPanStrategy is &apos; + vars.get(&apos;RRESOLVED_SUCC_LOST&apos;)
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;LOST successor was not created correctly&apos;)
}</stringProp>
