          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="30.1.3 - Require issued card: PIN depth card" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;STATUS_CARD_PIN&apos;) != &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_NOT_CONFIRMED&apos;)
    SampleResult.setResponseMessage(&apos;PIN depth card did not reach CONFIRMED: status=&apos; + vars.get(&apos;STATUS_CARD_PIN&apos;) +
        &apos;; operation=&apos; + vars.get(&apos;OP_CARD_PIN&apos;) + &apos;; polls=&apos; + vars.get(&apos;POLL_CARD_PIN&apos;) +
        &apos;; UNKNOWN observed &apos; + vars.get(&apos;UNKNOWN_CARD_PIN&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;PIN depth card card &apos; + vars.get(&apos;CARD_PIN&apos;), &apos;UTF-8&apos;)
}</stringProp>
