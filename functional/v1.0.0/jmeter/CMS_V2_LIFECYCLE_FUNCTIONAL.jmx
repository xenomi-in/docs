    assert (envelope.error?.code ?: envelope.errorCode) == &apos;BUSINESS_RULE_VIOLATION&apos; : &apos;Error code is &apos; + (envelope.error?.code ?: envelope.errorCode)
} catch (Exception | AssertionError failure) {
