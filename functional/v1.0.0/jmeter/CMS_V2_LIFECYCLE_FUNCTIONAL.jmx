    def data = envelope.data
    assert data.cardStatus == &apos;ACTIVE&apos; : &apos;The witness card is now &apos; + data.cardStatus
    assert data.lifecycleVersion.toString() == vars.get(&apos;V2_VERSION&apos;) : &apos;The witness lifecycleVersion moved to &apos; + data.lifecycleVersion
    assert data.maskedPan == vars.get(&apos;V2_PAN&apos;) : &apos;The witness PAN changed&apos;
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;An unrelated card changed during the restriction sequence&apos;)
}</stringProp>
