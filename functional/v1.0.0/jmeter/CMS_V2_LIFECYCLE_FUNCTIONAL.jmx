    embossedNameLine1: &apos;LF canonical lifecycle card&apos;
]))
vars.put(&apos;KEY_CARD_CL&apos;, vars.get(&apos;RUN_ID&apos;) + &apos;-cl&apos;)
vars.put(&apos;POLL_CARD_CL&apos;, &apos;0&apos;)
vars.put(&apos;CONT_CARD_CL&apos;, &apos;true&apos;)
