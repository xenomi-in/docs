            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;STATUS_CARD_T&apos;) != &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_NOT_CONFIRMED&apos;)
    SampleResult.setResponseMessage(&apos;T lineage card did not reach CONFIRMED: status=&apos; + vars.get(&apos;STATUS_CARD_T&apos;) +
        &apos;; operation=&apos; + vars.get(&apos;OP_CARD_T&apos;) + &apos;; polls=&apos; + vars.get(&apos;POLL_CARD_T&apos;) +
        &apos;; UNKNOWN observed &apos; + vars.get(&apos;UNKNOWN_CARD_T&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;T lineage card card &apos; + vars.get(&apos;CARD_T&apos;), &apos;UTF-8&apos;)
}</stringProp>
