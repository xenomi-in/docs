          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="19.11.3 - Require completed replacement: Q08 same-PAN renewal" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def successor = vars.get(&apos;SUCC_Q&apos;)
if (!(vars.get(&apos;RSTATUS_SUCC_Q&apos;) in [&apos;CONFIRMED&apos;, &apos;COMPLETED&apos;]) || !successor || successor == &apos;NOT_FOUND&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;REPLACEMENT_NOT_COMPLETED&apos;)
    SampleResult.setResponseMessage(&apos;Q08 same-PAN renewal status=&apos; + vars.get(&apos;RSTATUS_SUCC_Q&apos;) + &apos;; request=&apos; + vars.get(&apos;RREQ_SUCC_Q&apos;) +
        &apos;; polls=&apos; + vars.get(&apos;RPOLL_SUCC_Q&apos;) + &apos;; UNKNOWN observed &apos; + vars.get(&apos;RUNKNOWN_SUCC_Q&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;Q08 same-PAN renewal successor &apos; + successor + &apos; (resolved PAN strategy &apos; +
        (vars.get(&apos;RRESOLVED_SUCC_Q&apos;) ?: &apos;not reported&apos;) + &apos;)&apos;, &apos;UTF-8&apos;)
}</stringProp>
