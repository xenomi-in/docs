              <stringProp name="script">SampleResult.setResponseCode(&apos;SKIPPED&apos;)
SampleResult.setResponseMessage(vars.get(&apos;ACCOUNTING_LIMITS&apos;) == &apos;excluded&apos; ?
    &apos;Accounting checks excluded by SKIP_ACCOUNTING_TESTS=true&apos; : &apos;Accounting card-limit integration unavailable&apos;)
