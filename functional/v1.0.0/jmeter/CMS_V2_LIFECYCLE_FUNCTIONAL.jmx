            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (prev.responseCode != &apos;200&apos; || !vars.get(&apos;ACCESS_TOKEN&apos;) || vars.get(&apos;ACCESS_TOKEN&apos;) == &apos;NOT_FOUND&apos;) {
