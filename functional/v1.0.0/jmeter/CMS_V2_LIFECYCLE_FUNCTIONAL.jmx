            <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="14.10.1 - Poll Switch sync: controls enabled" enabled="true">
              <stringProp name="WhileController.condition">${__groovy(vars.get(&apos;SYNC_CARD_H&apos;) != &apos;true&apos; &amp;&amp; vars.get(&apos;SYNC_FAILED_CARD_H&apos;) != &apos;true&apos; &amp;&amp; Integer.parseInt(vars.get(&apos;SYNCPOLL_CARD_H&apos;)) &lt; Integer.parseInt(vars.get(&apos;SWITCH_SYNC_MAX_POLLS&apos;)))}</stringProp>
            </WhileController>
            <hashTree>
              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="14.10.1a - Read Switch sync: controls enabled" enabled="true">
                <intProp name="HTTPSampler.connect_timeout">10000</intProp>
                <intProp name="HTTPSampler.response_timeout">45000</intProp>
                <stringProp name="HTTPSampler.domain">${CMS_HOST}</stringProp>
                <stringProp name="HTTPSampler.port">${CMS_PORT}</stringProp>
                <stringProp name="HTTPSampler.protocol">${CMS_PROTOCOL}</stringProp>
                <stringProp name="HTTPSampler.path">/cms/api/v2/institutions/${INSTITUTION_ID}/cards/${CARD_H}/switch-sync</stringProp>
                <stringProp name="HTTPSampler.method">GET</stringProp>
                <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
                  <collectionProp name="Arguments.arguments">
                  </collectionProp>
                </elementProp>
              </HTTPSamplerProxy>
              <hashTree>
                <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Poll interval" enabled="true">
                  <stringProp name="ConstantTimer.delay">${POLL_INTERVAL_MS}</stringProp>
                </ConstantTimer>
                <hashTree/>
                <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Inspect Switch progress" enabled="true">
                  <stringProp name="scriptLanguage">groovy</stringProp>
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">try {
    vars.put(&apos;SYNCPOLL_CARD_H&apos;, (Integer.parseInt(vars.get(&apos;SYNCPOLL_CARD_H&apos;)) + 1).toString())
    assert prev.responseCode == &apos;200&apos;
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    if (data.enabled != true) {
        vars.put(&apos;SYNC_CARD_H&apos;, &apos;true&apos;)
        vars.put(&apos;SWITCH_SYNC_DISABLED&apos;, &apos;true&apos;)
        return
    }
    def pending = data.pendingCommands ?: []
    def failed = pending.find { it.status == &apos;FAILED&apos; }
    if (failed != null) {
        vars.put(&apos;SYNC_FAILED_CARD_H&apos;, &apos;true&apos;)
        vars.put(&apos;PENDING_CARD_H&apos;, failed.command_id + &apos;:&apos; + failed.status + &apos;:&apos; + failed.last_error)
    }
    assert failed == null : &apos;Switch command failed: &apos; + failed?.last_error
    long revision = (data.appliedRevision ?: 0) as long
    vars.put(&apos;REV_CARD_H&apos;, revision.toString())
    vars.put(&apos;PENDING_CARD_H&apos;, pending.collect { it.command_id + &apos;:&apos; + it.status }.join(&apos;, &apos;) ?: &apos;none&apos;)
    vars.put(&apos;SYNC_CARD_H&apos;, (pending.isEmpty() &amp;&amp; revision &gt; 0).toString())
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Switch-sync poll failed&apos;)
}</stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="filename"></stringProp>
                </JSR223Assertion>
                <hashTree/>
              </hashTree>
            </hashTree>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="14.10.2 - Require Switch settled: controls enabled" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">if (vars.get(&apos;SWITCH_SYNC_DISABLED&apos;) == &apos;true&apos;) {
    SampleResult.setResponseMessage(&apos;Durable Switch synchronization is disabled on this CMS instance&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
    return
}
if (vars.get(&apos;SYNC_CARD_H&apos;) != &apos;true&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(vars.get(&apos;SYNC_FAILED_CARD_H&apos;) == &apos;true&apos; ? &apos;SWITCH_SYNC_FAILED&apos; : &apos;SWITCH_SYNC_TIMEOUT&apos;)
    SampleResult.setResponseMessage(&apos;Switch did not settle for controls enabled within &apos; +
        vars.get(&apos;SWITCH_SYNC_MAX_POLLS&apos;) + &apos; polls; appliedRevision=&apos; + vars.get(&apos;REV_CARD_H&apos;) +
        &apos;; pending=&apos; + vars.get(&apos;PENDING_CARD_H&apos;))
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
    // Stop this dependent area, record the failed sample, and let other groups run.
    SampleResult.setStopThread(true)
    return
}
