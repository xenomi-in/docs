            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="The third generation keeps the PAN and moves further out" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.maskedPan == vars.get(&apos;K_PAN&apos;) : &apos;Generation three changed the PAN to &apos; + data.maskedPan
    def before = java.time.LocalDate.parse(vars.get(&apos;K_EXPIRY_2&apos;))
    def after = java.time.LocalDate.parse(data.expiryDate.toString())
    assert after.isAfter(before) : &apos;Generation three expires &apos; + after + &apos;, which is not after generation two &apos; + before
    assert data.lifecycleVersion == 1 : &apos;Generation three lifecycleVersion is &apos; + data.lifecycleVersion
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Generation three was not as configured&apos;)
}</stringProp>
