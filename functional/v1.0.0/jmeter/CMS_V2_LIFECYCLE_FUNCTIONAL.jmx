              <collectionProp name="HeaderManager.headers">
                <elementProp name="Idempotency-Key" elementType="Header">
                  <stringProp name="Header.name">Idempotency-Key</stringProp>
                  <stringProp name="Header.value">${RUN_ID}-d05-activate</stringProp>
                </elementProp>
                <elementProp name="X-Request-Id" elementType="Header">
                  <stringProp name="Header.name">X-Request-Id</stringProp>
                  <stringProp name="Header.value">${RUN_ID}-d05-activate-req</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Ignore HTTP status" enabled="true">
              <collectionProp name="Asserion.test_strings"/>
              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">true</boolProp>
              <intProp name="Assertion.test_type">1</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Activation either refuses or leaves the hold effective" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    if (prev.responseCode == &apos;200&apos;) {
        assert envelope.success == true
        assert envelope.data.cardStatus != &apos;ACTIVE&apos; :
            &apos;Activation cleared an independent CUSTOMER_FREEZE and returned ACTIVE. Activation must make the card use-ready without removing a restriction.&apos;
        vars.put(&apos;D05_OUTCOME&apos;, &apos;accepted with status &apos; + envelope.data.cardStatus)
    } else {
        assert prev.responseCode.startsWith(&apos;4&apos;) : &apos;Unexpected HTTP status: &apos; + prev.responseCode
        assert envelope.success == false
        vars.put(&apos;D05_OUTCOME&apos;, &apos;refused with HTTP &apos; + prev.responseCode)
    }
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Activation under hold behaved unexpectedly&apos;)
}</stringProp>
