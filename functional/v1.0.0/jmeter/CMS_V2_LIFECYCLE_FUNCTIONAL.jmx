            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Replay is idempotent" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert prev.getResponseHeaders().toLowerCase().replace(&apos; &apos;, &apos;&apos;).contains(&apos;idempotency-replayed:true&apos;) : &apos;The response was not marked as an idempotent replay&apos;
    assert data.eventId.toString() == vars.get(&apos;M1_EVENT_ID&apos;) : &apos;The replay raised a second lifecycle event &apos; + data.eventId
    assert data.lifecycleVersion.toString() == vars.get(&apos;M1_CLOSE_VERSION&apos;) : &apos;The replay advanced lifecycleVersion to &apos; + data.lifecycleVersion
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;The closure replay was not idempotent&apos;)
}</stringProp>
