          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="14.1.3 - Require issued card: H controls card" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;STATUS_CARD_H&apos;) != &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_NOT_CONFIRMED&apos;)
    SampleResult.setResponseMessage(&apos;H controls card did not reach CONFIRMED: status=&apos; + vars.get(&apos;STATUS_CARD_H&apos;) +
        &apos;; operation=&apos; + vars.get(&apos;OP_CARD_H&apos;) + &apos;; polls=&apos; + vars.get(&apos;POLL_CARD_H&apos;) +
        &apos;; UNKNOWN observed &apos; + vars.get(&apos;UNKNOWN_CARD_H&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;H controls card card &apos; + vars.get(&apos;CARD_H&apos;), &apos;UTF-8&apos;)
}</stringProp>
