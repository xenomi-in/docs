            </hashTree>
          </hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="11.1.3 - Require no card was created: B02 unknown customer reference" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;SYNCREJECT_B02C&apos;) == &apos;true&apos;) {
    SampleResult.setResponseData(&apos;B02 unknown customer reference was refused synchronously&apos;, &apos;UTF-8&apos;)
    return
}
def status = vars.get(&apos;STATUS_B02C&apos;)
if (status == &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;RULE_NOT_ENFORCED&apos;)
    SampleResult.setResponseMessage(&apos;B02 unknown customer reference produced a usable card; operation &apos; + vars.get(&apos;OP_B02C&apos;) +
        &apos; reached CONFIRMED.&apos; + &apos; No rule in the issuance path rejected it.&apos;)
} else {
    // FAILED is never written by application code, so a stuck PENDING/UNKNOWN is the real
    // signature of a worker-side abort. Either way no card became usable, but an operation
    // that never resolves is its own defect and is reported as one.
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_UNRESOLVED&apos;)
    SampleResult.setResponseMessage(&apos;B02 unknown customer reference was accepted with HTTP 202 and then never resolved: &apos; +
        vars.get(&apos;POLL_B02C&apos;) + &apos; polls, last status=&apos; + status + &apos;, result=&apos; + vars.get(&apos;REASON_B02C&apos;) +
        &apos;. The precondition should have been refused at submission.&apos;)
}
SampleResult.setResponseData(SampleResult.getResponseMessage() ?: &apos;&apos;, &apos;UTF-8&apos;)</stringProp>
