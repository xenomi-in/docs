          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="31.1.3 - Require issued card: canonical lifecycle card" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;STATUS_CARD_CL&apos;) != &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_NOT_CONFIRMED&apos;)
    SampleResult.setResponseMessage(&apos;canonical lifecycle card did not reach CONFIRMED: status=&apos; + vars.get(&apos;STATUS_CARD_CL&apos;) +
        &apos;; operation=&apos; + vars.get(&apos;OP_CARD_CL&apos;) + &apos;; polls=&apos; + vars.get(&apos;POLL_CARD_CL&apos;) +
        &apos;; UNKNOWN observed &apos; + vars.get(&apos;UNKNOWN_CARD_CL&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;canonical lifecycle card card &apos; + vars.get(&apos;CARD_CL&apos;), &apos;UTF-8&apos;)
}</stringProp>
