              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode == &apos;422&apos; : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == false : &apos;Rejection did not return a failure envelope&apos;
    def errorCode = envelope.error?.code ?: envelope.errorCode
    assert errorCode == &apos;BUSINESS_RULE_VIOLATION&apos; : &apos;Error code is &apos; + errorCode + &apos; body=&apos; + prev.responseDataAsString
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;A closure reason outside CUSTOMER_CLOSURE, BANK_CLOSURE and NON_ACTIVATION was accepted&apos;)
