            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Batch disabled" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    def batch = [&apos;DOMESTIC/ATM&apos;,&apos;DOMESTIC/POS_CONTACT&apos;,&apos;DOMESTIC/ECOM&apos;,&apos;DOMESTIC/MOTO&apos;,&apos;DOMESTIC/CONTACTLESS_POS&apos;,&apos;INTERNATIONAL/ATM&apos;,&apos;INTERNATIONAL/POS_CONTACT&apos;,&apos;INTERNATIONAL/ECOM&apos;] as Set
    def on = data.controls.findAll { (it.geography + &apos;/&apos; + it.channel) in batch &amp;&amp; it.enabled != false }.collect { it.geography + &apos;/&apos; + it.channel }
    assert on.isEmpty() : &apos;These dimensions did not disable: &apos; + on
    def revoked = data.controls.findAll { it.isAllowed != true }.collect { it.geography + &apos;/&apos; + it.channel }
    assert revoked.isEmpty() : &apos;Disabling revoked the product-derived permission on: &apos; + revoked
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Control batch 1 did not disable&apos;)
}</stringProp>
