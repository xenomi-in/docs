            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments">
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Expected HTTP 2\d\d" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="49015874">2\d\d</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">Expected HTTP 2\d\d</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">1</intProp>
            </ResponseAssertion>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Configured replacement policies are listed" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.content.size() &gt;= 6 : &apos;Expected at least the six bootstrap policies&apos;
    def reasons = data.content.collect { it.replacementReason } as Set
    assert reasons.containsAll([&apos;RENEWAL&apos;,&apos;DAMAGED&apos;,&apos;LOST&apos;,&apos;STOLEN&apos;,&apos;COMPROMISED&apos;,&apos;UPGRADE&apos;] as Set)
    def lost = data.content.find { it.replacementReason == &apos;LOST&apos; }
    assert lost.controlStrategy == &apos;APPLY_PRODUCT_DEFAULTS&apos; : &apos;LOST controlStrategy is &apos; + lost.controlStrategy
    assert lost.panStrategy == &apos;GENERATE_NEW_PAN&apos;
    assert lost.oldCardUsagePolicy == &apos;BLOCK_IMMEDIATELY&apos;
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Replacement policy list failed&apos;)
}</stringProp>
