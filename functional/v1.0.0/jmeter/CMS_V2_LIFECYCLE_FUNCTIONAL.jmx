          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="41.27 - Activate only new v2 PIN and personalisation fixtures" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.sql.Sql
try {
    assert vars.get(&apos;ALLOW_TEST_FIXTURES&apos;) == &apos;true&apos;
    def expected = vars.get(&apos;EXPECTED_TEST_DATABASE&apos;)
    assert expected &amp;&amp; vars.get(&apos;DB_URL&apos;).contains(&apos;/&apos; + expected) : &apos;Expected test database is required&apos;
    def db = Sql.newInstance(vars.get(&apos;DB_URL&apos;), vars.get(&apos;DB_USERNAME&apos;), vars.get(&apos;DB_PASSWORD&apos;), &apos;org.postgresql.Driver&apos;)
    try {
        def params = [vars.get(&apos;INSTITUTION_ID&apos;),vars.get(&apos;CLIENT_V2_ID&apos;)]
        assert params[1] &amp;&amp; params[1] != &apos;NOT_FOUND&apos;
        db.withTransaction {
            assert db.executeUpdate(&quot;update cms_v2.product_pin_policy set policy_status=&apos;ACTIVE&apos; where institution_id=?::uuid and product_version_id=?::uuid and policy_status=&apos;DRAFT&apos;&quot;,params) == 1
            assert db.executeUpdate(&quot;update cms_v2.product_personalisation_policy set policy_status=&apos;ACTIVE&apos; where institution_id=?::uuid and product_version_id=?::uuid and policy_status=&apos;DRAFT&apos;&quot;,params) == 1
        }
        SampleResult.setResponseData(&apos;Activated policies only for new version &apos;+params[1], &apos;UTF-8&apos;)
    } finally { db.close() }
} catch (Exception | AssertionError failure) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;CLIENT_CONFIGURATION_FAILED&apos;)
    SampleResult.setResponseMessage(failure.message ?: &apos;Client configuration assertion failed&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
}</stringProp>
