            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Card is VIRTUAL and still PENDING, with no production request" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.cardForm == &apos;VIRTUAL&apos; : &apos;cardForm is &apos; + data.cardForm
    assert data.issuanceMode == &apos;VIRTUAL_THEN_PHYSICAL_LATER&apos; : &apos;issuanceMode is &apos; + data.issuanceMode
    assert data.cardStatus == &apos;PENDING&apos; : &apos;cardStatus is &apos; + data.cardStatus
    assert data.digitalAvailable == true
    assert data.productionRequestId == null : &apos;Production existed before it was requested&apos;
    assert data.maskedPan
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Later-mode card was not a pending virtual card&apos;)
}</stringProp>
