          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="17.1.3 - Require issued card: K09 generation one" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;STATUS_CARD_K&apos;) != &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_NOT_CONFIRMED&apos;)
    SampleResult.setResponseMessage(&apos;K09 generation one did not reach CONFIRMED: status=&apos; + vars.get(&apos;STATUS_CARD_K&apos;) +
        &apos;; operation=&apos; + vars.get(&apos;OP_CARD_K&apos;) + &apos;; polls=&apos; + vars.get(&apos;POLL_CARD_K&apos;) +
        &apos;; UNKNOWN observed &apos; + vars.get(&apos;UNKNOWN_CARD_K&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;K09 generation one card &apos; + vars.get(&apos;CARD_K&apos;), &apos;UTF-8&apos;)
}</stringProp>
