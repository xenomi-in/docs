            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="18.16.2 - Require Switch settled: closed card" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">if (vars.get(&apos;SWITCH_SYNC_DISABLED&apos;) == &apos;true&apos;) {
    SampleResult.setResponseMessage(&apos;Durable Switch synchronization is disabled on this CMS instance&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
    return
}
if (vars.get(&apos;SYNC_CARD_M2&apos;) != &apos;true&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(vars.get(&apos;SYNC_FAILED_CARD_M2&apos;) == &apos;true&apos; ? &apos;SWITCH_SYNC_FAILED&apos; : &apos;SWITCH_SYNC_TIMEOUT&apos;)
    SampleResult.setResponseMessage(&apos;Switch did not settle for closed card within &apos; +
        vars.get(&apos;SWITCH_SYNC_MAX_POLLS&apos;) + &apos; polls; appliedRevision=&apos; + vars.get(&apos;REV_CARD_M2&apos;) +
        &apos;; pending=&apos; + vars.get(&apos;PENDING_CARD_M2&apos;))
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
    // Stop this dependent area, record the failed sample, and let other groups run.
    SampleResult.setStopThread(true)
    return
}
SampleResult.setResponseData(&apos;closed card settled at Switch revision &apos; + vars.get(&apos;REV_CARD_M2&apos;), &apos;UTF-8&apos;)</stringProp>
