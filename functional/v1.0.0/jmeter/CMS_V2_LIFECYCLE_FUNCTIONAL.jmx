          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="17.9 - K09 Three generations are distinct records on one PAN" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def one = vars.get(&apos;CARD_K&apos;)
def two = vars.get(&apos;SUCC_K1&apos;)
def three = vars.get(&apos;SUCC_K2&apos;)
assert one &amp;&amp; two &amp;&amp; three : &apos;All three generations must exist&apos;
assert [one, two, three].toSet().size() == 3 : &apos;Renewal reused a card id across generations: &apos; + [one, two, three]
SampleResult.setResponseData(&apos;Generations &apos; + one + &apos; -&gt; &apos; + two + &apos; -&gt; &apos; + three, &apos;UTF-8&apos;)</stringProp>
