            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Verify rejection" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode == &apos;422&apos; : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == false : &apos;Rejection did not return a failure envelope&apos;
    def errorCode = envelope.error?.code ?: envelope.errorCode
    assert errorCode == &apos;BUSINESS_RULE_VIOLATION&apos; : &apos;Error code is &apos; + errorCode
    def message = (envelope.error?.message ?: &apos;&apos;).toString()
    assert message.contains(&apos;not eligible&apos;) : message
    assert !prev.responseDataAsString.toLowerCase().contains(&apos;0123456789abcdef&apos;)
    assert !prev.responseDataAsString.toLowerCase().contains(&apos;fedcba9876543210&apos;)
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;PIN change was accepted on a lost card&apos;)
}</stringProp>
