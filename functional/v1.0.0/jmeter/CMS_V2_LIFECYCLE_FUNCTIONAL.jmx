          <hashTree/>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="24.6.1 - Submit replacement: T02 lineage renewal" enabled="true">
            <intProp name="HTTPSampler.connect_timeout">10000</intProp>
            <intProp name="HTTPSampler.response_timeout">90000</intProp>
            <stringProp name="HTTPSampler.domain">${CMS_HOST}</stringProp>
            <stringProp name="HTTPSampler.port">${CMS_PORT}</stringProp>
            <stringProp name="HTTPSampler.protocol">${CMS_PROTOCOL}</stringProp>
            <stringProp name="HTTPSampler.path">/cms/api/v2/institutions/${INSTITUTION_ID}/cards/${CARD_T}/replacement</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;replacementReason&quot;:&quot;RENEWAL&quot;,&quot;requestedPanStrategy&quot;:&quot;PRESERVE_EXISTING_PAN&quot;,&quot;overrideReason&quot;:&quot;Lifecycle functional T02 lineage renewal&quot;}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Headers" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="Idempotency-Key" elementType="Header">
                  <stringProp name="Header.name">Idempotency-Key</stringProp>
                  <stringProp name="Header.value">${RUN_ID}-t-renew</stringProp>
                </elementProp>
                <elementProp name="X-Request-Id" elementType="Header">
                  <stringProp name="Header.name">X-Request-Id</stringProp>
                  <stringProp name="Header.value">${RUN_ID}-t-renew-req</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Replacement accepted" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;, &apos;202&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    def requestId = (data.operationId ?: data.replacementRequestId)?.toString()
    assert requestId : &apos;Replacement returned no operation or request id&apos;
    assert data.sourceCardId == vars.get(&apos;CARD_T&apos;) : &apos;Replacement was raised against &apos; + data.sourceCardId
    assert data.replacementReason == &apos;RENEWAL&apos; : &apos;Replacement reason is &apos; + data.replacementReason
    vars.put(&apos;RREQ_SUCC_T&apos;, requestId)
    vars.put(&apos;RSTATUS_SUCC_T&apos;, (data.operationStatus ?: data.requestStatus ?: &apos;PENDING&apos;).toString())
    if (data.policyPanStrategy) vars.put(&apos;RPOLICY_SUCC_T&apos;, data.policyPanStrategy.toString())
    if (data.replacementCardId) vars.put(&apos;SUCC_T&apos;, data.replacementCardId.toString())
    if (vars.get(&apos;RSTATUS_SUCC_T&apos;) in [&apos;CONFIRMED&apos;, &apos;COMPLETED&apos;]) vars.put(&apos;RCONT_SUCC_T&apos;, &apos;false&apos;)
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;T02 lineage renewal submit failed&apos;)
}</stringProp>
