          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="28.13.3 - Require issued card: PHYSICAL_ONLY card" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;STATUS_CARD_PHYS&apos;) != &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_NOT_CONFIRMED&apos;)
    SampleResult.setResponseMessage(&apos;PHYSICAL_ONLY card did not reach CONFIRMED: status=&apos; + vars.get(&apos;STATUS_CARD_PHYS&apos;) +
        &apos;; operation=&apos; + vars.get(&apos;OP_CARD_PHYS&apos;) + &apos;; polls=&apos; + vars.get(&apos;POLL_CARD_PHYS&apos;) +
        &apos;; UNKNOWN observed &apos; + vars.get(&apos;UNKNOWN_CARD_PHYS&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;PHYSICAL_ONLY card card &apos; + vars.get(&apos;CARD_PHYS&apos;), &apos;UTF-8&apos;)
}</stringProp>
