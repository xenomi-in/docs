            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Issuance is refused at submission" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    if (prev.responseCode != &apos;202&apos;) {
        assert prev.responseCode.startsWith(&apos;4&apos;) : &apos;Expected a 4xx rejection, got HTTP &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
        assert envelope.success == false : &apos;Rejection did not return a failure envelope&apos;
        vars.put(&apos;SYNCREJECT_C05&apos;, &apos;true&apos;)
        vars.put(&apos;CONT_C05&apos;, &apos;false&apos;)
        assert (envelope.error?.message ?: &apos;&apos;).contains(&apos;active virtual PANs&apos;) : &apos;Refused for another reason: &apos; + envelope.error?.message
        return
    }
    // Accepted. Let the poll below decide whether a card was actually produced, so the
    // report distinguishes &quot;the rule is not enforced&quot; from &quot;the worker stalled&quot;.
    assert envelope.success == true
    vars.put(&apos;OP_C05&apos;, envelope.data.operationId.toString())
    vars.put(&apos;STATUS_C05&apos;, envelope.data.status.toString())
    vars.put(&apos;CONT_C05&apos;, &apos;true&apos;)
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;C05 second card beyond the single-PAN ceiling was not refused&apos;)
}</stringProp>
