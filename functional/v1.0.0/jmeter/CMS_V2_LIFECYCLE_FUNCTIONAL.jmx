            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;STATUS_CARD_M3&apos;) != &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_NOT_CONFIRMED&apos;)
    SampleResult.setResponseMessage(&apos;M09 sibling card did not reach CONFIRMED: status=&apos; + vars.get(&apos;STATUS_CARD_M3&apos;) +
        &apos;; operation=&apos; + vars.get(&apos;OP_CARD_M3&apos;) + &apos;; polls=&apos; + vars.get(&apos;POLL_CARD_M3&apos;) +
        &apos;; UNKNOWN observed &apos; + vars.get(&apos;UNKNOWN_CARD_M3&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;M09 sibling card card &apos; + vars.get(&apos;CARD_M3&apos;), &apos;UTF-8&apos;)
}</stringProp>
