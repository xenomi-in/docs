                <collectionProp name="Arguments.arguments">
                  <elementProp name="" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">{&quot;controls&quot;:[{&quot;geography&quot;:&quot;DOMESTIC&quot;,&quot;channel&quot;:&quot;ECOM&quot;,&quot;enabled&quot;:true,&quot;perTransactionLimitMinor&quot;:${LIMIT_AT_CEILING}}],&quot;reasonCode&quot;:&quot;LF_I03&quot;}</stringProp>
