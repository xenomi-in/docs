            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="History returns metadata only" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.content != null
    def body = prev.responseDataAsString.toLowerCase()
    assert !body.contains(&apos;encryptedpinblock&apos;)
    assert !body.contains(&apos;pinoffset&apos;)
    data.content.each { row -&gt;
      assert row.pinHistoryId != null
      assert row.operationType != null
    }
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;PIN history leaked sensitive material or failed&apos;)
}</stringProp>
