            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Only domestic POS is enabled and every dimension is allowed" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.controls?.size() == 10 : &apos;Expected 10 dimensions, found &apos; + (data.controls?.size())
    def notAllowed = data.controls.findAll { it.isAllowed != true }.collect { it.geography + &apos;/&apos; + it.channel }
    assert notAllowed.isEmpty() : &apos;These dimensions are not allowed by the product: &apos; + notAllowed
    def enabled = data.controls.findAll { it.enabled == true }.collect { it.geography + &apos;/&apos; + it.channel } as Set
    assert enabled == [&apos;DOMESTIC/POS_CONTACT&apos;] as Set : &apos;Enabled dimensions are &apos; + enabled
    vars.put(&apos;H_BASE_VERSION&apos;, data.controlVersion.toString())
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;The initial control profile was not the product default&apos;)
}</stringProp>
