          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="19.10 - Q02 Compare the CMS card with the Switch profile" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.sql.Sql
def switchTableColumns = { db, table -&gt;
    db.rows(&apos;&apos;&apos;
select column_name
from information_schema.columns
where table_schema = current_schema()
  and table_name = ?
order by ordinal_position
&apos;&apos;&apos;, [table]).collect { it.column_name.toString() }
}
def switchCardIdColumn = { db, table -&gt;
    def names = switchTableColumns(db, table)
    def preferred = [&apos;cms_card_id&apos;, &apos;card_id&apos;, &apos;cms_card_uuid&apos;, &apos;card_uuid&apos;, &apos;cms_card_reference&apos;, &apos;external_card_id&apos;]
    return preferred.find { names.contains(it) }
}
def stage = &apos;check whether the comparison applies&apos;
try {
    if (vars.get(&apos;WAIT_FOR_SWITCH_SYNC&apos;) != &apos;true&apos; || vars.get(&apos;SWITCH_SYNC_DISABLED&apos;) == &apos;true&apos;) {
        SampleResult.setResponseData(&apos;Skipped; durable Switch synchronization is not enabled for this run&apos;, &apos;UTF-8&apos;)
        return
    }
    assert vars.get(&apos;SWITCH_DB_URL&apos;)?.trim() : &apos;SWITCH_DB_URL is required to compare profiles&apos;
    stage = &apos;connect to the Switch database&apos;
    def db = Sql.newInstance(vars.get(&apos;SWITCH_DB_URL&apos;), vars.get(&apos;SWITCH_DB_USERNAME&apos;), vars.get(&apos;SWITCH_DB_PASSWORD&apos;) ?: &apos;&apos;, &apos;org.postgresql.Driver&apos;)
    try {
        stage = &apos;locate the CMS card id column on cms_card_profile&apos;
        def column = switchCardIdColumn(db, &apos;cms_card_profile&apos;)
        assert column : &apos;No CMS card id column found on cms_card_profile; columns=&apos; + switchTableColumns(db, &apos;cms_card_profile&apos;)
        stage = &apos;read the Switch card profile&apos;
        def rows = db.rows(&apos;select * from cms_card_profile where &apos; + column + &apos; = ?::uuid&apos;, [vars.get(&apos;CARD_Q&apos;)])
        assert rows.size() == 1 : &apos;The Switch holds &apos; + rows.size() + &apos; profiles for CMS card &apos; + vars.get(&apos;CARD_Q&apos;) + &apos;; exactly one is expected&apos;
        def profile = rows[0]
        stage = &apos;confirm no command is still outstanding&apos;
        def commandColumn = switchCardIdColumn(db, &apos;cms_card_command&apos;)
        def commandNote = &apos;&apos;
        if (commandColumn) {
            def outstanding = db.rows(&apos;select * from cms_card_command where &apos; + commandColumn +
                &quot; = ?::uuid and status not in (&apos;APPLIED&apos;, &apos;SUCCEEDED&apos;, &apos;COMPLETED&apos;)&quot;, [vars.get(&apos;CARD_Q&apos;)])
            assert outstanding.isEmpty() : &apos;The Switch still has &apos; + outstanding.size() + &apos; outstanding commands&apos;
        } else {
            commandNote = &apos;; outstanding-command check skipped because cms_card_command has no CMS card id column (&apos; +
                switchTableColumns(db, &apos;cms_card_command&apos;).join(&apos;, &apos;) + &apos;)&apos;
        }
        SampleResult.setResponseData(&apos;Switch profile for &apos; + vars.get(&apos;CARD_Q&apos;) + &apos;: &apos; +
            profile.collect { k, v -&gt; k + &apos;=&apos; + v }.join(&apos;, &apos;) + commandNote, &apos;UTF-8&apos;)
    } finally { db.close() }
} catch (Exception | AssertionError failure) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;SWITCH_PROFILE_MISMATCH&apos;)
    SampleResult.setResponseMessage(&apos;Switch profile comparison failed at: &apos; + stage + &apos;; error=&apos; + (failure.message ?: failure.class.simpleName))
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
}</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223Sampler>
