              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.maskedPan == vars.get(&apos;J1_PAN&apos;) : &apos;The replacement changed the source PAN&apos;
    vars.put(&apos;J1_FINAL_STATUS&apos;, data.cardStatus.toString())
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Could not read the source after replacement&apos;)
}</stringProp>
