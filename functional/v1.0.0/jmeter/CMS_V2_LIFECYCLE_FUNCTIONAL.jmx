        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="23.4 - S03 Determine the scope of this plan&apos;s token" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def token = vars.get(&apos;ACCESS_TOKEN&apos;)
assert token : &apos;No access token to inspect&apos;
def parts = token.split(&apos;\\.&apos;)
assert parts.length &gt;= 2 : &apos;The access token is not a JWT&apos;
def payload = new String(Base64.getUrlDecoder().decode(parts[1]), &apos;UTF-8&apos;)
def claims = new groovy.json.JsonSlurper().parseText(payload)
def platform = claims.platform_access?.toString() == &apos;true&apos;
vars.put(&apos;TOKEN_IS_PLATFORM&apos;, platform.toString())
vars.put(&apos;TOKEN_INSTITUTION&apos;, (claims.institution_id ?: &apos;none&apos;).toString())
SampleResult.setResponseData(&apos;platform_access=&apos; + platform + &apos; institution_id=&apos; + vars.get(&apos;TOKEN_INSTITUTION&apos;), &apos;UTF-8&apos;)</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="23.5 - S03 An unknown institution is not found and leaks nothing" enabled="true">
          <intProp name="HTTPSampler.connect_timeout">10000</intProp>
          <intProp name="HTTPSampler.response_timeout">45000</intProp>
          <stringProp name="HTTPSampler.domain">${CMS_HOST}</stringProp>
          <stringProp name="HTTPSampler.port">${CMS_PORT}</stringProp>
          <stringProp name="HTTPSampler.protocol">${CMS_PROTOCOL}</stringProp>
          <stringProp name="HTTPSampler.path">/cms/api/v2/institutions/00000000-0000-4000-8000-0000000000bb/cards?page=1&amp;limit=1</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
            <collectionProp name="Arguments.arguments">
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Headers" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="Authorization" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">Bearer ${ACCESS_TOKEN}</stringProp>
              </elementProp>
              <elementProp name="Accept" elementType="Header">
                <stringProp name="Header.name">Accept</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
              <elementProp name="Content-Type" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
              <elementProp name="X-Actor-Id" elementType="Header">
                <stringProp name="Header.name">X-Actor-Id</stringProp>
                <stringProp name="Header.value">${CMS_ACTOR_ID}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Ignore HTTP status" enabled="true">
            <collectionProp name="Asserion.test_strings"/>
            <stringProp name="Assertion.custom_message"></stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">true</boolProp>
            <intProp name="Assertion.test_type">1</intProp>
          </ResponseAssertion>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Verify the unknown institution is refused" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">try {
    def accepted = [&apos;403&apos;,&apos;404&apos;]
    assert prev.responseCode in accepted : &apos;Expected a rejection in &apos; + accepted + &apos; but got HTTP &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == false : &apos;Rejection did not return a failure envelope&apos;
    def errorCode = envelope.error?.code ?: envelope.errorCode ?: &apos;not reported&apos;
    assert errorCode in [&apos;TENANT_ACCESS_DENIED&apos;, &apos;PLATFORM_ACCESS_REQUIRED&apos;, &apos;ACCESS_DENIED&apos;, &apos;NOT_FOUND&apos;] : &apos;Error code is &apos; + errorCode
    assert !prev.responseDataAsString.contains(&apos;maskedPan&apos;) : &apos;The rejection leaked card data&apos;
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;A read against an unknown institution was served&apos;)
}</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223Assertion>
