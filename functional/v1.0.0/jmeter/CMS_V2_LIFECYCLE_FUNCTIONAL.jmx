            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">vars.put(&apos;BODY_CARD_K&apos;, groovy.json.JsonOutput.toJson([
    customerReferenceId: vars.get(&apos;CUSTOMER_REFERENCE_ID&apos;),
    accountReferenceId: vars.get(&apos;ACCOUNT_REF_14&apos;),
