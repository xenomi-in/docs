            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="A future-dated draft version can be created" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.versionStatus == &apos;DRAFT&apos;
    assert data.versionNumber &gt; 1 : &apos;Expected a version number after the active version&apos;
    assert data.effectiveFrom.toString().startsWith(&apos;2030-01-01&apos;)
    vars.put(&apos;FUTURE_VERSION_ID&apos;, data.productVersionId.toString())
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Could not create a post-activation product version&apos;)
}</stringProp>
