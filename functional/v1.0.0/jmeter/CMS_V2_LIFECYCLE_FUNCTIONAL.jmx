    assert pos &amp;&amp; pos.enabled == true &amp;&amp; pos.perTransactionLimitMinor.toString() == vars.get(&apos;PRODUCT_LIMIT_DEFAULT_MINOR&apos;)
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Other product inherited the changed product defaults&apos;)
