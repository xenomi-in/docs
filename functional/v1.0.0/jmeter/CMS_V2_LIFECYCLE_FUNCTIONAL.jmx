          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="12.12.3 - Require no card was created: C05 second card beyond the single-PAN ceiling" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;SYNCREJECT_C05&apos;) == &apos;true&apos;) {
    SampleResult.setResponseData(&apos;C05 second card beyond the single-PAN ceiling was refused synchronously&apos;, &apos;UTF-8&apos;)
    return
}
def status = vars.get(&apos;STATUS_C05&apos;)
if (status == &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;RULE_NOT_ENFORCED&apos;)
    SampleResult.setResponseMessage(&apos;C05 second card beyond the single-PAN ceiling produced a usable card; operation &apos; + vars.get(&apos;OP_C05&apos;) +
        &apos; reached CONFIRMED.&apos; + &apos; The product maximumActiveVirtualPans ceiling was not applied at issuance.&apos;)
} else {
    // FAILED is never written by application code, so a stuck PENDING/UNKNOWN is the real
    // signature of a worker-side abort. Either way no card became usable, but an operation
    // that never resolves is its own defect and is reported as one.
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_UNRESOLVED&apos;)
    SampleResult.setResponseMessage(&apos;C05 second card beyond the single-PAN ceiling was accepted with HTTP 202 and then never resolved: &apos; +
        vars.get(&apos;POLL_C05&apos;) + &apos; polls, last status=&apos; + status + &apos;, result=&apos; + vars.get(&apos;REASON_C05&apos;) +
        &apos;. The precondition should have been refused at submission.&apos;)
}
SampleResult.setResponseData(SampleResult.getResponseMessage() ?: &apos;&apos;, &apos;UTF-8&apos;)</stringProp>
