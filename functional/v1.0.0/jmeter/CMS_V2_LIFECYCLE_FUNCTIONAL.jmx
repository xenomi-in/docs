            <stringProp name="script">vars.put(&apos;RPOLL_SUCC_T&apos;, &apos;0&apos;)
vars.put(&apos;RCONT_SUCC_T&apos;, &apos;true&apos;)
vars.put(&apos;RSTATUS_SUCC_T&apos;, &apos;PENDING&apos;)
vars.put(&apos;RUNKNOWN_SUCC_T&apos;, &apos;0&apos;)</stringProp>
