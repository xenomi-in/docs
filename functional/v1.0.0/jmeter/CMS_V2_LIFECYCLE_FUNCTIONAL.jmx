          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="16.1.3 - Require issued card: J01 replacement source" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;STATUS_CARD_J1&apos;) != &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_NOT_CONFIRMED&apos;)
    SampleResult.setResponseMessage(&apos;J01 replacement source did not reach CONFIRMED: status=&apos; + vars.get(&apos;STATUS_CARD_J1&apos;) +
        &apos;; operation=&apos; + vars.get(&apos;OP_CARD_J1&apos;) + &apos;; polls=&apos; + vars.get(&apos;POLL_CARD_J1&apos;) +
        &apos;; UNKNOWN observed &apos; + vars.get(&apos;UNKNOWN_CARD_J1&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;J01 replacement source card &apos; + vars.get(&apos;CARD_J1&apos;), &apos;UTF-8&apos;)
}</stringProp>
