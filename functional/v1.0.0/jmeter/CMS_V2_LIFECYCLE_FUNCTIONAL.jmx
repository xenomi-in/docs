            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="29.5s.2 - Require Switch settled: LOST security-replacement successor" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">if (vars.get(&apos;SWITCH_SYNC_DISABLED&apos;) == &apos;true&apos;) {
    SampleResult.setResponseMessage(&apos;Durable Switch synchronization is disabled on this CMS instance&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
    return
}
if (vars.get(&apos;SYNC_SUCC_LOST&apos;) != &apos;true&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(vars.get(&apos;SYNC_FAILED_SUCC_LOST&apos;) == &apos;true&apos; ? &apos;SWITCH_SYNC_FAILED&apos; : &apos;SWITCH_SYNC_TIMEOUT&apos;)
    SampleResult.setResponseMessage(&apos;Switch did not settle for LOST security-replacement successor within &apos; +
        vars.get(&apos;SWITCH_SYNC_MAX_POLLS&apos;) + &apos; polls; appliedRevision=&apos; + vars.get(&apos;REV_SUCC_LOST&apos;) +
        &apos;; pending=&apos; + vars.get(&apos;PENDING_SUCC_LOST&apos;))
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
    // Stop this dependent area, record the failed sample, and let other groups run.
    SampleResult.setStopThread(true)
    return
}
SampleResult.setResponseData(&apos;LOST security-replacement successor settled at Switch revision &apos; + vars.get(&apos;REV_SUCC_LOST&apos;), &apos;UTF-8&apos;)</stringProp>
