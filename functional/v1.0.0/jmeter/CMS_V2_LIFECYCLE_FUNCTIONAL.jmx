          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="00.0 - Initialize run data" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.time.OffsetDateTime
import java.time.ZoneOffset
import java.util.UUID
try {
    assert vars.get(&apos;ALLOW_TEST_FIXTURES&apos;) == &apos;true&apos; : &apos;Set ALLOW_TEST_FIXTURES=true against a disposable database&apos;
    def databaseMatch = (vars.get(&apos;DB_URL&apos;) ?: &apos;&apos;) =~ /^jdbc:postgresql:\/\/[^\/]+\/([^?\/]+)(?:\?.*)?$/
    if (!vars.get(&apos;EXPECTED_TEST_DATABASE&apos;)?.trim() || !databaseMatch.matches() || databaseMatch.group(1) != vars.get(&apos;EXPECTED_TEST_DATABASE&apos;)) {
        throw new IllegalArgumentException(&apos;DB_URL must target EXPECTED_TEST_DATABASE (database name, not schema name)&apos;)
    }
    assert vars.get(&apos;DB_USERNAME&apos;)?.trim() : &apos;DB_USERNAME is required&apos;
    assert vars.get(&apos;KEYCLOAK_CLIENT_SECRET&apos;)?.trim() : &apos;KEYCLOAK_CLIENT_SECRET is required&apos;
    assert Integer.parseInt(vars.get(&apos;MAX_POLLS&apos;)) in 1..300
    assert Integer.parseInt(vars.get(&apos;SWITCH_SYNC_MAX_POLLS&apos;)) in 1..300
    assert Integer.parseInt(vars.get(&apos;POLL_INTERVAL_MS&apos;)) in 100..10000
    assert vars.get(&apos;WAIT_FOR_SWITCH_SYNC&apos;) in [&apos;true&apos;, &apos;false&apos;]
    assert vars.get(&apos;SKIP_ACCOUNTING_TESTS&apos;) in [&apos;true&apos;, &apos;false&apos;]
    assert vars.get(&apos;CUSTOMER_SERVICE_HOST&apos;)?.trim() : &apos;CUSTOMER_SERVICE_HOST is required&apos;
    assert vars.get(&apos;CUSTOMER_SERVICE_PORT&apos;)?.trim() : &apos;CUSTOMER_SERVICE_PORT is required&apos;
    assert vars.get(&apos;CUSTOMER_SERVICE_PROTOCOL&apos;)?.trim() : &apos;CUSTOMER_SERVICE_PROTOCOL is required&apos;
    assert vars.get(&apos;CUSTOMER_SOURCE_SYSTEM&apos;)?.trim() : &apos;CUSTOMER_SOURCE_SYSTEM is required&apos;
    def suffix = Long.toString(System.currentTimeMillis(), 36).toUpperCase()
    vars.put(&apos;RUN_SUFFIX&apos;, suffix)
    vars.put(&apos;RUN_ID&apos;, &apos;lf-&apos; + suffix.toLowerCase())
    vars.put(&apos;INSTITUTION_ID&apos;, &apos;01a0a5f5-f71d-7d0f-ba69-a020a51bbbc1&apos;)
    vars.put(&apos;BUSINESS_DATE&apos;, java.time.LocalDate.now(ZoneOffset.UTC).toString())
    vars.put(&apos;EFFECTIVE_FROM&apos;, OffsetDateTime.now(ZoneOffset.UTC).minusMinutes(1).toString())
    // A prior disposable run may already own a randomly chosen BIN. Check the
    // database before creating this run&apos;s configuration instead of failing setup.
    def fixtureDb = groovy.sql.Sql.newInstance(vars.get(&apos;DB_URL&apos;), vars.get(&apos;DB_USERNAME&apos;), vars.get(&apos;DB_PASSWORD&apos;), &apos;org.postgresql.Driver&apos;)
    def chooseUnusedBin = { digits, lower, spread -&gt;
        for (int attempt = 0; attempt &lt; 20; attempt++) {
            def candidate = String.format(&apos;%0&apos; + digits + &apos;d&apos;, lower + ((UUID.randomUUID().hashCode() &amp; 0x7fffffff) % spread))
            if (fixtureDb.firstRow(&apos;select count(*) as matches from cms_v2.bin_configuration where bin_number = ?&apos;, [candidate]).matches == 0) return candidate
        }
        throw new IllegalStateException(&apos;Could not select an unused disposable BIN after 20 candidates&apos;)
    }
    def bin
    def bin8
    try {
        bin = chooseUnusedBin(6, 400000, 100000)
        bin8 = chooseUnusedBin(8, 40000000, 10000000)
    } finally { fixtureDb.close() }
    vars.put(&apos;BIN_NUMBER&apos;, bin)
    // Two ranges on the same BIN. The second is activated but never assigned to a product,
    // which is what the A03 &quot;range not assigned&quot; rejection needs.
    vars.put(&apos;RANGE_START&apos;, bin + &apos;0000000000&apos;)
    vars.put(&apos;RANGE_END&apos;, bin + &apos;0000009999&apos;)
    vars.put(&apos;UNASSIGNED_RANGE_START&apos;, bin + &apos;0000010000&apos;)
    vars.put(&apos;UNASSIGNED_RANGE_END&apos;, bin + &apos;0000019999&apos;)
    // Customer, account and address UUIDs come from customer-service V2 responses (sampler 06).
    vars.put(&apos;ACTIVATION_POLICY_VERSION_ID&apos;, UUID.randomUUID().toString())
    vars.put(&apos;VENDOR_ID&apos;, UUID.randomUUID().toString())
    vars.put(&apos;BATCH_CONFIG_ID&apos;, UUID.randomUUID().toString())
    vars.put(&apos;BIN8_NUMBER&apos;, bin8)
    vars.put(&apos;MAIN_PRODUCT_CODE&apos;, &apos;VIRTUAL_MAIN_&apos; + suffix)
    vars.put(&apos;SWITCH_SYNC_DISABLED&apos;, &apos;false&apos;)
    SampleResult.setResponseData(&apos;Initialized &apos; + vars.get(&apos;RUN_ID&apos;) + &apos; BIN &apos; + bin, &apos;UTF-8&apos;)
} catch (Exception | AssertionError failure) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;CONFIGURATION_ERROR&apos;)
    SampleResult.setResponseMessage(failure.message ?: &apos;Invalid configuration&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
}</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="00.1 - Seed Switch BIN for this run" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import groovy.sql.Sql
def stage = &apos;skip check&apos;
try {
    if (vars.get(&apos;WAIT_FOR_SWITCH_SYNC&apos;) != &apos;true&apos;) {
        SampleResult.setResponseData(&apos;Skipped Switch BIN seed; WAIT_FOR_SWITCH_SYNC=false&apos;, &apos;UTF-8&apos;)
        return
    }
    def bin = vars.get(&apos;BIN_NUMBER&apos;)
    def inst = Integer.parseInt(vars.get(&apos;SWITCH_BIN_INSTITUTION_ID&apos;) ?: &apos;0&apos;)
    assert inst &gt; 0 : &apos;SWITCH_BIN_INSTITUTION_ID must be the Switch institutions.institution_id that owns CHD keys&apos;
    assert vars.get(&apos;SWITCH_DB_URL&apos;)?.trim() : &apos;SWITCH_DB_URL is required when WAIT_FOR_SWITCH_SYNC=true&apos;
    stage = &apos;connect to Switch database&apos;
    def db = Sql.newInstance(vars.get(&apos;SWITCH_DB_URL&apos;), vars.get(&apos;SWITCH_DB_USERNAME&apos;), vars.get(&apos;SWITCH_DB_PASSWORD&apos;) ?: &apos;&apos;, &apos;org.postgresql.Driver&apos;)
    try {
        db.withTransaction {
            // Each run owns unique card/account fixtures. Preserve earlier Switch records.
            stage = &apos;align Switch institution currency to CMS numeric INR (356)&apos;
            def currencyCol = db.firstRow(&apos;&apos;&apos;
select column_name
from information_schema.columns
where table_schema = current_schema()
  and table_name = &apos;institutions&apos;
  and column_name in (&apos;currency&apos;, &apos;currency_code&apos;, &apos;default_currency&apos;, &apos;base_currency&apos;, &apos;iso_currency_code&apos;)
order by case column_name
  when &apos;currency&apos; then 1
  when &apos;currency_code&apos; then 2
  when &apos;default_currency&apos; then 3
  when &apos;base_currency&apos; then 4
  else 5 end
limit 1
&apos;&apos;&apos;)
            assert currencyCol?.column_name : &apos;institutions has no currency column&apos;
            db.execute(&apos;update institutions set &apos; + currencyCol.column_name + &apos; = ? where institution_id = ?&apos;, [&apos;356&apos;, inst])
            db.executeUpdate(&quot;update bin_details set currency = &apos;356&apos; where institution_id = ? and currency is distinct from &apos;356&apos;&quot;, [inst])
            try {
                db.executeUpdate(&quot;update bins set currency = &apos;356&apos; where institution_id = ? and currency is distinct from &apos;356&apos;&quot;, [inst])
            } catch (Exception ignored) {}
            stage = &apos;insert bin_details&apos;
            db.firstRow(&apos;&apos;&apos;select case
  when pg_get_serial_sequence(&apos;bin_details&apos;, &apos;bin_id&apos;) is null then 0
  else setval(pg_get_serial_sequence(&apos;bin_details&apos;, &apos;bin_id&apos;), (select coalesce(max(bin_id), 1) from bin_details))
end as v&apos;&apos;&apos;)
            db.executeUpdate(&apos;&apos;&apos;insert into bin_details (
    institution_id, bin_number, card_type, card_scheme, card_level, currency, status,
    decline_on_sda_failure, decline_on_dda_failure, decline_on_cda_failure, allow_offline_pin)
select ?, ?, &apos;CREDIT&apos;, &apos;VISA&apos;, &apos;CLASSIC&apos;, &apos;356&apos;, &apos;ACTIVE&apos;, false, false, false, true
where not exists (select 1 from bin_details where bin_number = ?)&apos;&apos;&apos;, [inst, bin, bin])
            try {
                db.firstRow(&apos;&apos;&apos;select case
  when pg_get_serial_sequence(&apos;bins&apos;, &apos;bin_id&apos;) is null then 0
  else setval(pg_get_serial_sequence(&apos;bins&apos;, &apos;bin_id&apos;), (select coalesce(max(bin_id), 1) from bins))
end as v&apos;&apos;&apos;)
                db.executeUpdate(&apos;&apos;&apos;insert into bins (
    institution_id, bin_number, card_type, card_scheme, card_level, currency, status)
select ?, ?, &apos;CREDIT&apos;, &apos;VISA&apos;, &apos;CLASSIC&apos;, &apos;356&apos;, &apos;ACTIVE&apos;
where not exists (select 1 from bins where bin_number = ?)&apos;&apos;&apos;, [inst, bin, bin])
            } catch (Exception ignored) {}
        }
    } finally { db.close() }
    stage = &apos;refresh Switch BIN cache&apos;
    // Cache management is a separately secured Switch API. Use a dedicated
    // client with switch:cache:manage; never reuse the CMS bearer token.
    def cacheTokenUrl = props.getProperty(&apos;SWITCH_CACHE_TOKEN_URL&apos;, &apos;&apos;).trim()
    def cacheClientId = props.getProperty(&apos;SWITCH_CACHE_CLIENT_ID&apos;, &apos;&apos;).trim()
    def cacheClientSecret = props.getProperty(&apos;SWITCH_CACHE_CLIENT_SECRET&apos;, &apos;&apos;).trim()
    assert cacheTokenUrl &amp;&amp; cacheClientId &amp;&amp; cacheClientSecret : &apos;Switch cache fixture requires SWITCH_CACHE_TOKEN_URL, SWITCH_CACHE_CLIENT_ID and SWITCH_CACHE_CLIENT_SECRET with switch:cache:manage&apos;
    def tokenConn = new URL(cacheTokenUrl).openConnection()
    tokenConn.setRequestMethod(&apos;POST&apos;)
    tokenConn.setConnectTimeout(5000)
    tokenConn.setReadTimeout(15000)
    tokenConn.setDoOutput(true)
    tokenConn.setRequestProperty(&apos;Content-Type&apos;, &apos;application/x-www-form-urlencoded&apos;)
    def encode = { value -&gt; java.net.URLEncoder.encode(value, &apos;UTF-8&apos;) }
    def tokenForm = &apos;grant_type=client_credentials&amp;client_id=&apos; + encode(cacheClientId) + &apos;&amp;client_secret=&apos; + encode(cacheClientSecret) + &apos;&amp;scope=&apos; + encode(&apos;switch:cache:manage&apos;)
    tokenConn.outputStream.withCloseable { it.write(tokenForm.getBytes(&apos;UTF-8&apos;)) }
    assert tokenConn.responseCode in 200..299 : &apos;Switch cache fixture authentication failed HTTP &apos; + tokenConn.responseCode
    def cacheToken = new groovy.json.JsonSlurper().parseText(tokenConn.inputStream.getText(&apos;UTF-8&apos;)).access_token
    assert cacheToken : &apos;Switch cache fixture authentication did not return an access token&apos;
    def refreshUrl = (vars.get(&apos;SWITCH_BASE_URL&apos;) ?: &apos;http://localhost:8090&apos;).replaceAll(&apos;/+$&apos;, &apos;&apos;) + &apos;/api/cache/refresh/bin-institution&apos;
    def conn = new URL(refreshUrl).openConnection()
    conn.setRequestMethod(&apos;POST&apos;)
    conn.setRequestProperty(&apos;Authorization&apos;, &apos;Bearer &apos; + cacheToken)
    conn.setConnectTimeout(5000)
    conn.setReadTimeout(15000)
    conn.setDoOutput(true)
    def code = conn.responseCode
    def body = (code &gt;= 400 ? conn.errorStream : conn.inputStream)?.getText(&apos;UTF-8&apos;)
    assert code in 200..299 : &apos;Switch BIN cache refresh failed HTTP &apos; + code + &apos; &apos; + body
    SampleResult.setResponseData(&apos;Seeded Switch BIN &apos; + bin + &apos; institution &apos; + inst, &apos;UTF-8&apos;)
} catch (Exception | AssertionError failure) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;SWITCH_BIN_SEED_ERROR&apos;)
    def cause = failure
    while (cause.cause != null &amp;&amp; cause.cause != cause) { cause = cause.cause }
    SampleResult.setResponseMessage(&apos;Switch BIN seed failed at: &apos; + stage + &apos;; error=&apos; + (failure.message ?: cause.class.simpleName))
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
}</stringProp>
