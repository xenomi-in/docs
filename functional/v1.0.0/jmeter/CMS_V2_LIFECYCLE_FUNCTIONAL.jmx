            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Physical-only card has a masked PAN and an immediate production request" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.cardForm == &apos;PHYSICAL&apos; : &apos;cardForm is &apos; + data.cardForm
    assert data.issuanceMode == &apos;PHYSICAL_ONLY&apos; : &apos;issuanceMode is &apos; + data.issuanceMode
    assert data.cardStatus == &apos;PENDING&apos;
    assert data.digitalAvailable == false
    assert data.maskedPan : &apos;masked PAN missing&apos;
    assert data.panLastFour?.length() == 4
    assert data.productionRequestId : &apos;PHYSICAL_ONLY created no production request&apos;
    vars.put(&apos;PHYS_LAST4&apos;, data.panLastFour.toString())
    vars.put(&apos;PHYS_ACCOUNT&apos;, data.accountReferenceId.toString())
    vars.put(&apos;PHYS_VERSION&apos;, data.lifecycleVersion.toString())
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;PHYSICAL_ONLY card did not match the physical issuance contract&apos;)
}</stringProp>
