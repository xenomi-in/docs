            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="41.60 - Prepare issuance: CLIENT CARD D" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">vars.put(&apos;BODY_CLIENT_CARD_D&apos;, groovy.json.JsonOutput.toJson([
    customerReferenceId: vars.get(&apos;CUSTOMER_REFERENCE_ID&apos;),
    accountReferenceId: vars.get(&apos;CLIENT_ACCOUNT_4&apos;),
    productId: vars.get(&apos;CLIENT_PRODUCT_ID&apos;),
    productVersionId: vars.get(&apos;CLIENT_V2_ID&apos;),
    binRangeId: vars.get(&apos;CLIENT_RANGE_B&apos;),
    activationPolicyVersionId: vars.get(&apos;ACTIVATION_POLICY_VERSION_ID&apos;),
    accountLinkType: &apos;PRIMARY_FUNDING&apos;,
