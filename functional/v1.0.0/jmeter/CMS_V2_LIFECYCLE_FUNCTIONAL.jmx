            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Frozen renewal is either refused or accepted without dropping the hold" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    if (prev.responseCode in [&apos;200&apos;, &apos;201&apos;, &apos;202&apos;]) {
        assert envelope.success == true
        vars.put(&apos;K07_OUTCOME&apos;, &apos;accepted; the frozen source must keep its hold&apos;)
    } else {
        assert prev.responseCode.startsWith(&apos;4&apos;) : &apos;Unexpected HTTP status: &apos; + prev.responseCode
        assert envelope.success == false
        vars.put(&apos;K07_OUTCOME&apos;, &apos;refused with HTTP &apos; + prev.responseCode)
    }
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Renewal under hold behaved unexpectedly&apos;)
}</stringProp>
