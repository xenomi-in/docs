            <stringProp name="script">vars.put(&apos;BODY_C05&apos;, groovy.json.JsonOutput.toJson([customerReferenceId: vars.get(&apos;CUSTOMER_REFERENCE_ID&apos;), accountReferenceId: vars.get(&apos;ACCOUNT_REF_7&apos;), productId: vars.get(&apos;CEILING_PRODUCT_ID&apos;), productVersionId: vars.get(&apos;CEILING_PRODUCT_VERSION_ID&apos;), binRangeId: vars.get(&apos;BIN_RANGE_ID&apos;), activationPolicyVersionId: vars.get(&apos;ACTIVATION_POLICY_VERSION_ID&apos;), accountLinkType: &apos;PRIMARY_FUNDING&apos;, embossedNameLine1: &apos;LF NEGATIVE&apos;]))
vars.put(&apos;KEY_C05&apos;, vars.get(&apos;RUN_ID&apos;) + &apos;-c05-2&apos;)
