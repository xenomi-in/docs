    assert envelope.success == false : &apos;Rejection did not return a failure envelope&apos;
    def errorCode = envelope.error?.code ?: envelope.errorCode ?: &apos;not reported&apos;
    assert errorCode != &apos;not reported&apos;
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Inverted range boundaries were accepted&apos;)
}</stringProp>
