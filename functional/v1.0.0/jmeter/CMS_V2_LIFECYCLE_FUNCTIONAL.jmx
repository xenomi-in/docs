          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="15.1 - Prepare issuance: I limits card" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">vars.put(&apos;BODY_CARD_I&apos;, groovy.json.JsonOutput.toJson([
    customerReferenceId: vars.get(&apos;CUSTOMER_REFERENCE_ID&apos;),
    accountReferenceId: vars.get(&apos;ACCOUNT_REF_11&apos;),
    productId: vars.get(&apos;PRODUCT_ID&apos;),
    productVersionId: vars.get(&apos;PRODUCT_VERSION_ID&apos;),
    binRangeId: vars.get(&apos;BIN_RANGE_ID&apos;),
    activationPolicyVersionId: vars.get(&apos;ACTIVATION_POLICY_VERSION_ID&apos;),
    accountLinkType: &apos;PRIMARY_FUNDING&apos;,
    embossedNameLine1: &apos;LF I limits card&apos;
]))
vars.put(&apos;KEY_CARD_I&apos;, vars.get(&apos;RUN_ID&apos;) + &apos;-i&apos;)
vars.put(&apos;POLL_CARD_I&apos;, &apos;0&apos;)
vars.put(&apos;CONT_CARD_I&apos;, &apos;true&apos;)
vars.put(&apos;STATUS_CARD_I&apos;, &apos;PENDING&apos;)
vars.put(&apos;UNKNOWN_CARD_I&apos;, &apos;0&apos;)</stringProp>
