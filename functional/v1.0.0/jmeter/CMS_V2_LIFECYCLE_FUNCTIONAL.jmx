              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode == &apos;400&apos; : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == false : &apos;Rejection did not return a failure envelope&apos;
    assert envelope.success == false
    assert (envelope.error?.code ?: envelope.errorCode) != null
    assert envelope.meta?.requestId != null
    assert envelope.meta?.timestamp != null
    assert prev.getResponseHeaders().toLowerCase().contains(&apos;x-request-id&apos;)
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Error envelope contract failed&apos;)
}</stringProp>
