        &apos;; UNKNOWN observed &apos; + vars.get(&apos;UNKNOWN_CARD_Q&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;Q switch card card &apos; + vars.get(&apos;CARD_Q&apos;), &apos;UTF-8&apos;)
}</stringProp>
