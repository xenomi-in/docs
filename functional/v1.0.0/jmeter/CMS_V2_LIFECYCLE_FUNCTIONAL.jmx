              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Product isolation on same BIN" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.productId == vars.get(&apos;CLIENT_OTHER_PRODUCT&apos;)
    assert data.productId != vars.get(&apos;CLIENT_PRODUCT_ID&apos;)
    assert data.productVersionId == vars.get(&apos;CLIENT_OTHER_VERSION&apos;)
    assert data.binId == vars.get(&apos;BIN_ID&apos;)
    assert data.binRangeId == vars.get(&apos;BIN_RANGE_ID&apos;)
    assert data.cardForm == &apos;VIRTUAL&apos;
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Shared BIN product isolation failed&apos;)
}</stringProp>
