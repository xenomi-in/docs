        <hashTree>
          <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract TENANT_TOKEN" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">TENANT_TOKEN</stringProp>
