            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Same-day card is virtual and physical, with a different PAN mask from the physical-only card" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.cardForm == &apos;VIRTUAL_PHYSICAL&apos; : &apos;cardForm is &apos; + data.cardForm
    assert data.issuanceMode == &apos;VIRTUAL_AND_PHYSICAL_SAME_DAY&apos; : &apos;issuanceMode is &apos; + data.issuanceMode
    assert data.digitalAvailable == true
    assert data.maskedPan
    assert data.panLastFour?.length() == 4
    assert data.productionRequestId : &apos;SAME_DAY created no production request&apos;
    assert data.panLastFour.toString() != vars.get(&apos;PHYS_LAST4&apos;) : &apos;Same-day PAN last four matched the physical-only card&apos;
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;SAME_DAY card did not match the dual-form issuance contract&apos;)
}</stringProp>
