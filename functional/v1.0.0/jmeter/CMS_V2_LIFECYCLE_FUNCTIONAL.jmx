          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="12.11.3 - Require issued card: C05 first card at the ceiling" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;STATUS_CARD_CEIL&apos;) != &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_NOT_CONFIRMED&apos;)
    SampleResult.setResponseMessage(&apos;C05 first card at the ceiling did not reach CONFIRMED: status=&apos; + vars.get(&apos;STATUS_CARD_CEIL&apos;) +
        &apos;; operation=&apos; + vars.get(&apos;OP_CARD_CEIL&apos;) + &apos;; polls=&apos; + vars.get(&apos;POLL_CARD_CEIL&apos;) +
        &apos;; UNKNOWN observed &apos; + vars.get(&apos;UNKNOWN_CARD_CEIL&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;C05 first card at the ceiling card &apos; + vars.get(&apos;CARD_CEIL&apos;), &apos;UTF-8&apos;)
}</stringProp>
