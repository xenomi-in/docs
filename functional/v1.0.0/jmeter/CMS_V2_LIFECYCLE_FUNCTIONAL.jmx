        &apos;; operation=&apos; + vars.get(&apos;OP_CARD_ELIG&apos;) + &apos;; polls=&apos; + vars.get(&apos;POLL_CARD_ELIG&apos;) +
        &apos;; UNKNOWN observed &apos; + vars.get(&apos;UNKNOWN_CARD_ELIG&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;non-security eligibility card card &apos; + vars.get(&apos;CARD_ELIG&apos;), &apos;UTF-8&apos;)
