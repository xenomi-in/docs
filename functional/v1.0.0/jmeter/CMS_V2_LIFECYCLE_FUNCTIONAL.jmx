              <stringProp name="script">SampleResult.setSuccessful(true)
SampleResult.setResponseCode(&apos;SKIPPED&apos;)
SampleResult.setResponseData(&apos;Card C was not issued; dependent card and controls checks were not executed.&apos;,&apos;UTF-8&apos;)</stringProp>
