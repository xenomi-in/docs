            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Replacement accepted" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;, &apos;202&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    def requestId = (data.operationId ?: data.replacementRequestId)?.toString()
    assert requestId : &apos;Replacement returned no operation or request id&apos;
    assert data.sourceCardId == vars.get(&apos;CARD_RB_STOLEN&apos;) : &apos;Replacement was raised against &apos; + data.sourceCardId
    assert data.replacementReason == &apos;STOLEN&apos; : &apos;Replacement reason is &apos; + data.replacementReason
    vars.put(&apos;RREQ_SUCC_STOLEN&apos;, requestId)
    vars.put(&apos;RSTATUS_SUCC_STOLEN&apos;, (data.operationStatus ?: data.requestStatus ?: &apos;PENDING&apos;).toString())
    if (data.policyPanStrategy) vars.put(&apos;RPOLICY_SUCC_STOLEN&apos;, data.policyPanStrategy.toString())
    if (data.replacementCardId) vars.put(&apos;SUCC_STOLEN&apos;, data.replacementCardId.toString())
    if (vars.get(&apos;RSTATUS_SUCC_STOLEN&apos;) in [&apos;CONFIRMED&apos;, &apos;COMPLETED&apos;]) vars.put(&apos;RCONT_SUCC_STOLEN&apos;, &apos;false&apos;)
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;STOLEN new-PAN security replacement submit failed&apos;)
}</stringProp>
