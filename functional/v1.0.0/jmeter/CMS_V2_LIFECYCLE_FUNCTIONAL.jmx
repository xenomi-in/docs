            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Unestablished family cannot change PIN" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == false : &apos;PIN change returned a success envelope&apos;
    def message = (envelope.error?.message ?: &apos;&apos;).toString()
    def confirmed = prev.responseCode == &apos;409&apos; &amp;&amp; message.contains(&apos;not confirmed&apos;)
    def unestablished = prev.responseCode == &apos;422&apos; &amp;&amp; message.contains(&apos;established PIN&apos;)
    assert confirmed || unestablished : &apos;Expected the profile-version or unestablished-PIN refusal, got HTTP &apos; + prev.responseCode + &apos;: &apos; + message
    assert !prev.responseDataAsString.toLowerCase().contains(&apos;0123456789abcdef&apos;)
    assert !prev.responseDataAsString.toLowerCase().contains(&apos;fedcba9876543210&apos;)
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Unestablished PIN change was unexpected&apos;)
}</stringProp>
