              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    if (data.cardId != null) { assert data.cardId == vars.get(&apos;CARD_Q&apos;) : &apos;switch-sync reports card &apos; + data.cardId }
    assert data.enabled != null : &apos;switch-sync did not report whether the integration is enabled&apos;
    if (data.enabled == true) { assert data.appliedRevision != null : &apos;An enabled integration reported no appliedRevision&apos; }
    vars.put(&apos;Q_ENABLED&apos;, data.enabled.toString())
    vars.put(&apos;Q_EARLY_REVISION&apos;, (data.appliedRevision ?: 0).toString())
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;The switch-sync view was not readable&apos;)
}</stringProp>
