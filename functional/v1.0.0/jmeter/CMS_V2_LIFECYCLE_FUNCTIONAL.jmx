            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="ECOM, MOTO, contactless and international are off; contact channels remain" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    def enabled = data.controls.findAll { it.enabled == true }.collect { it.geography + &apos;/&apos; + it.channel } as Set
    def shouldBeOff = data.controls.findAll { it.enabled == true &amp;&amp; (it.geography == &apos;INTERNATIONAL&apos; || it.channel in [&apos;ECOM&apos;, &apos;MOTO&apos;, &apos;CONTACTLESS_POS&apos;]) }
    assert shouldBeOff.isEmpty() : &apos;Renewal left these reissue-off dimensions enabled on the source: &apos; + shouldBeOff.collect { it.geography + &apos;/&apos; + it.channel }
    assert enabled.contains(&apos;DOMESTIC/POS_CONTACT&apos;) : &apos;Renewal also switched off a contact channel it should not touch; the source enabled set is &apos; + enabled
    assert data.internationalEnabled == false : &apos;The source international scope is still &apos; + data.internationalEnabled
    assert (data.controlVersion as int) &gt; Integer.parseInt(vars.get(&apos;J1_CONTROL_VERSION&apos;)) : &apos;The reissue-off change did not advance the source controlVersion past &apos; + vars.get(&apos;J1_CONTROL_VERSION&apos;)
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;The renewal did not apply the reissue-off defaults to the source&apos;)
}</stringProp>
