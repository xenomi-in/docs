    def item = (data.content ?: []).find { it.cardId == vars.get(&apos;CARD_T&apos;) }
    assert item != null : &apos;The card is missing from its own account listing&apos;
    assert item.cardStatus == &apos;ACTIVE&apos; : &apos;The listing reports &apos; + item.cardStatus + &apos; but the detail view reports ACTIVE&apos;
    assert item.maskedPan == vars.get(&apos;T_PAN&apos;) : &apos;The listing reports a different masked PAN&apos;
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;List and detail disagreed&apos;)
