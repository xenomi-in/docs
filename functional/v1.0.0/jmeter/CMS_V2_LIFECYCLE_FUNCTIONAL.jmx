            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="The card is still CLOSED at the same version" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.cardStatus == &apos;CLOSED&apos; : &apos;cardStatus is &apos; + data.cardStatus
    assert data.lifecycleVersion.toString() == vars.get(&apos;M1_CLOSE_VERSION&apos;) : &apos;A refused operation advanced lifecycleVersion to &apos; + data.lifecycleVersion
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;A refused operation changed a closed card&apos;)
}</stringProp>
