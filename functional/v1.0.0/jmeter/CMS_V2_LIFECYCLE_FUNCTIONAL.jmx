            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Successor assignment applies and old assignment is retained" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.content.any { it.hsmKeyId == vars.get(&apos;CVV_KEY_ID&apos;) &amp;&amp; it.assignmentStatus == &apos;VERIFY_ONLY&apos; }
    assert data.content.any { it.hsmKeyId == vars.get(&apos;CLIENT_CVK_B&apos;) &amp;&amp; it.assignmentStatus == &apos;ACTIVE&apos; }
    assert data.content.count { it.assignmentStatus == &apos;ACTIVE&apos; } == 1
    vars.put(&apos;CLIENT_ROTATION_READY&apos;,&apos;true&apos;)
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;BIN key successor did not preserve old verification assignment&apos;)
}</stringProp>
