          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="11.5 - B04 The two cards are distinct identities" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def first = vars.get(&apos;CARD_B1&apos;)
def second = vars.get(&apos;CARD_B2&apos;)
assert first &amp;&amp; second : &apos;Both fixture cards must exist&apos;
assert first != second : &apos;Two issuance requests returned the same card id &apos; + first
SampleResult.setResponseData(&apos;Distinct cards &apos; + first + &apos; and &apos; + second, &apos;UTF-8&apos;)</stringProp>
