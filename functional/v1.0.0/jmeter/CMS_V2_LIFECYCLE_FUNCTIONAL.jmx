          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="17.4.1 - Submit replacement: K09 first renewal" enabled="true">
            <intProp name="HTTPSampler.connect_timeout">10000</intProp>
