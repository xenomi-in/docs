        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="26.0 - Load shared configuration for institution restrictions" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">try {
    def missing = []
    [&apos;RUN_ID&apos;,&apos;RUN_SUFFIX&apos;,&apos;INSTITUTION_ID&apos;,&apos;BIN_ID&apos;,&apos;BIN_NUMBER&apos;,&apos;BIN_RANGE_ID&apos;,&apos;UNASSIGNED_RANGE_ID&apos;,&apos;PRODUCT_ID&apos;,&apos;PRODUCT_VERSION_ID&apos;,&apos;BIN_ASSIGNMENT_ID&apos;,&apos;CEILING_PRODUCT_ID&apos;,&apos;CEILING_PRODUCT_VERSION_ID&apos;,&apos;DRAFT_PRODUCT_ID&apos;,&apos;DRAFT_PRODUCT_VERSION_ID&apos;,&apos;CUSTOMER_REFERENCE_ID&apos;,&apos;SECOND_CUSTOMER_REFERENCE_ID&apos;,&apos;ACTIVATION_POLICY_VERSION_ID&apos;,&apos;RENEWAL_POLICY_ID&apos;,&apos;DAMAGED_POLICY_ID&apos;,&apos;LOST_POLICY_ID&apos;,&apos;STOLEN_POLICY_ID&apos;,&apos;COMPROMISED_POLICY_ID&apos;,&apos;BLOCKED_REASON_POLICY_ID&apos;,&apos;BIN8_ID&apos;,&apos;BIN8_NUMBER&apos;,&apos;VENDOR_ID&apos;,&apos;BATCH_CONFIG_ID&apos;,&apos;ADDRESS_REF_ID&apos;,&apos;VIRTUAL_DESIGN_ID&apos;,&apos;PHYSICAL_DESIGN_ID&apos;,&apos;TECH_PROFILE_ID&apos;,&apos;CVM_PROFILE_ID&apos;,&apos;LIMIT_ID&apos;,&apos;MAIN_PRODUCT_CODE&apos;,&apos;PHYS_LATER_PRODUCT_ID&apos;,&apos;PHYS_LATER_VERSION_ID&apos;,&apos;PHYS_ONLY_PRODUCT_ID&apos;,&apos;PHYS_ONLY_VERSION_ID&apos;,&apos;SAME_DAY_PRODUCT_ID&apos;,&apos;SAME_DAY_VERSION_ID&apos;,&apos;MULTI_PRODUCT_ID&apos;,&apos;MULTI_VERSION_ID&apos;,&apos;PAN_ENCRYPTION_KEY_ID&apos;,&apos;PAN_HMAC_KEY_ID&apos;,&apos;CVV_KEY_ID&apos;,&apos;EMV_IMK_KEY_ID&apos;,&apos;BUSINESS_DATE&apos;,&apos;EFFECTIVE_FROM&apos;,&apos;RANGE_START&apos;,&apos;RANGE_END&apos;,&apos;UNASSIGNED_RANGE_START&apos;,&apos;UNASSIGNED_RANGE_END&apos;,&apos;ACCOUNT_REF_1&apos;,&apos;ACCOUNT_REF_2&apos;,&apos;ACCOUNT_REF_3&apos;,&apos;ACCOUNT_REF_4&apos;,&apos;ACCOUNT_REF_5&apos;,&apos;ACCOUNT_REF_6&apos;,&apos;ACCOUNT_REF_7&apos;,&apos;ACCOUNT_REF_8&apos;,&apos;ACCOUNT_REF_9&apos;,&apos;ACCOUNT_REF_10&apos;,&apos;ACCOUNT_REF_11&apos;,&apos;ACCOUNT_REF_12&apos;,&apos;ACCOUNT_REF_13&apos;,&apos;ACCOUNT_REF_14&apos;,&apos;ACCOUNT_REF_15&apos;,&apos;ACCOUNT_REF_16&apos;,&apos;ACCOUNT_REF_17&apos;,&apos;ACCOUNT_REF_18&apos;,&apos;ACCOUNT_REF_19&apos;,&apos;ACCOUNT_REF_20&apos;,&apos;ACCOUNT_REF_21&apos;,&apos;ACCOUNT_REF_22&apos;,&apos;ACCOUNT_REF_23&apos;,&apos;ACCOUNT_REF_24&apos;,&apos;ACCOUNT_REF_25&apos;,&apos;ACCOUNT_REF_26&apos;,&apos;ACCOUNT_REF_27&apos;,&apos;ACCOUNT_REF_28&apos;,&apos;ACCOUNT_REF_29&apos;,&apos;ACCOUNT_REF_30&apos;,&apos;ACCOUNT_REF_31&apos;,&apos;ACCOUNT_REF_32&apos;,&apos;ACCOUNT_REF_33&apos;,&apos;ACCOUNT_REF_34&apos;,&apos;ACCOUNT_REF_35&apos;,&apos;ACCOUNT_REF_36&apos;,&apos;ACCOUNT_REF_37&apos;,&apos;ACCOUNT_REF_38&apos;,&apos;ACCOUNT_REF_39&apos;,&apos;ACCOUNT_REF_40&apos;].each { key -&gt;
        def value = props.get(&apos;LF_&apos; + key)
        if (value == null || value.toString().trim().isEmpty()) {
            missing &lt;&lt; key
        } else {
            vars.put(key, value.toString())
        }
    }
    assert missing.isEmpty() : &apos;The bootstrap thread group did not publish: &apos; + missing +
        &apos;. Run the whole plan in order; area groups cannot run against an empty property map.&apos;
    vars.put(&apos;AREA&apos;, &apos;institution restrictions&apos;)
    SampleResult.setResponseData(&apos;Loaded shared configuration for institution restrictions: institution &apos; + vars.get(&apos;INSTITUTION_ID&apos;), &apos;UTF-8&apos;)
} catch (Exception | AssertionError failure) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;BOOTSTRAP_MISSING&apos;)
    SampleResult.setResponseMessage(failure.message ?: &apos;Shared configuration is unavailable&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
    // Without the shared configuration every sampler below would fail against a real API,
    // so end this area rather than generating noise.
    SampleResult.setStopThread(true)
}</stringProp>
