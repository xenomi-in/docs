          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="12.11 - Prepare issuance: C05 first card at the ceiling" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">vars.put(&apos;BODY_CARD_CEIL&apos;, groovy.json.JsonOutput.toJson([
    customerReferenceId: vars.get(&apos;CUSTOMER_REFERENCE_ID&apos;),
    accountReferenceId: vars.get(&apos;ACCOUNT_REF_7&apos;),
    productId: vars.get(&apos;CEILING_PRODUCT_ID&apos;),
    productVersionId: vars.get(&apos;CEILING_PRODUCT_VERSION_ID&apos;),
    binRangeId: vars.get(&apos;BIN_RANGE_ID&apos;),
    activationPolicyVersionId: vars.get(&apos;ACTIVATION_POLICY_VERSION_ID&apos;),
    accountLinkType: &apos;PRIMARY_FUNDING&apos;,
    embossedNameLine1: &apos;LF C05 first card at the ceiling&apos;
]))
vars.put(&apos;KEY_CARD_CEIL&apos;, vars.get(&apos;RUN_ID&apos;) + &apos;-c05-1&apos;)
vars.put(&apos;POLL_CARD_CEIL&apos;, &apos;0&apos;)
vars.put(&apos;CONT_CARD_CEIL&apos;, &apos;true&apos;)
vars.put(&apos;STATUS_CARD_CEIL&apos;, &apos;PENDING&apos;)
vars.put(&apos;UNKNOWN_CARD_CEIL&apos;, &apos;0&apos;)</stringProp>
