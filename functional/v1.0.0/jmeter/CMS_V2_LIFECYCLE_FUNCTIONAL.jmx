    binRangeId: vars.get(&apos;BIN_RANGE_ID&apos;),
    activationPolicyVersionId: vars.get(&apos;ACTIVATION_POLICY_VERSION_ID&apos;),
    accountLinkType: &apos;PRIMARY_FUNDING&apos;,
    embossedNameLine1: &apos;LF H controls card&apos;
]))
vars.put(&apos;KEY_CARD_H&apos;, vars.get(&apos;RUN_ID&apos;) + &apos;-h&apos;)
vars.put(&apos;POLL_CARD_H&apos;, &apos;0&apos;)
vars.put(&apos;CONT_CARD_H&apos;, &apos;true&apos;)
vars.put(&apos;STATUS_CARD_H&apos;, &apos;PENDING&apos;)
vars.put(&apos;UNKNOWN_CARD_H&apos;, &apos;0&apos;)</stringProp>
