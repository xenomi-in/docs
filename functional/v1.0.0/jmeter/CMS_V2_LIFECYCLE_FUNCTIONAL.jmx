            <stringProp name="script">SampleResult.setSuccessful(false)
SampleResult.setResponseCode(&apos;TENANCY_UNPROVEN&apos;)
SampleResult.setResponseMessage(
    &apos;S03 tenant isolation was NOT tested. This plan authenticates with a platform-scoped client &apos; +
    &apos;(platform_access=&apos; + vars.get(&apos;TOKEN_IS_PLATFORM&apos;) + &apos;), and CmsJwtRequestContextFilter lets a platform &apos; +
    &apos;subject reach any institution path, so no request made with it can demonstrate isolation. Set &apos; +
    &apos;TENANT_KEYCLOAK_CLIENT_ID and TENANT_KEYCLOAK_CLIENT_SECRET to a client scoped to a different &apos; +
    &apos;institution and without platform access, then re-run.&apos;)</stringProp>
