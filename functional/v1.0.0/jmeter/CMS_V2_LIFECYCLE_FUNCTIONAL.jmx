          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="24.6.3 - Require completed replacement: T02 lineage renewal" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def successor = vars.get(&apos;SUCC_T&apos;)
if (!(vars.get(&apos;RSTATUS_SUCC_T&apos;) in [&apos;CONFIRMED&apos;, &apos;COMPLETED&apos;]) || !successor || successor == &apos;NOT_FOUND&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;REPLACEMENT_NOT_COMPLETED&apos;)
    SampleResult.setResponseMessage(&apos;T02 lineage renewal status=&apos; + vars.get(&apos;RSTATUS_SUCC_T&apos;) + &apos;; request=&apos; + vars.get(&apos;RREQ_SUCC_T&apos;) +
        &apos;; polls=&apos; + vars.get(&apos;RPOLL_SUCC_T&apos;) + &apos;; UNKNOWN observed &apos; + vars.get(&apos;RUNKNOWN_SUCC_T&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;T02 lineage renewal successor &apos; + successor + &apos; (resolved PAN strategy &apos; +
        (vars.get(&apos;RRESOLVED_SUCC_T&apos;) ?: &apos;not reported&apos;) + &apos;)&apos;, &apos;UTF-8&apos;)
}</stringProp>
