            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Hotlist business rule, or permission not granted" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    def code = prev.responseCode
    if (code in [&apos;401&apos;, &apos;403&apos;]) {
        SampleResult.setResponseMessage(&apos;Hotlist permission is not on this client; the business rule was not reached&apos;)
        return
    }
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    def message = (envelope.error?.message ?: &apos;&apos;).toString().toLowerCase()
    assert code == &apos;422&apos; : &apos;Expected 422 once hotlist is authorized, got HTTP &apos; + code + &apos; &apos; + message
    assert message.contains(&apos;hold api&apos;) : message
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;hotlist rule unexpected&apos;)
}</stringProp>
