            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="One CLOSED and one ACTIVE card remain visible" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    def items = data.content
    assert items?.size() == 2 : &apos;Expected 2 cards on the account, found &apos; + (items?.size())
    def byId = items.collectEntries { [(it.cardId): it.cardStatus] }
    assert byId[vars.get(&apos;CARD_M2&apos;)] == &apos;CLOSED&apos; : &apos;The closed card lists as &apos; + byId[vars.get(&apos;CARD_M2&apos;)]
    assert byId[vars.get(&apos;CARD_M3&apos;)] == &apos;ACTIVE&apos; : &apos;The sibling lists as &apos; + byId[vars.get(&apos;CARD_M3&apos;)]
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;The account listing did not reflect the closure&apos;)
}</stringProp>
