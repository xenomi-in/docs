          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Protected fields have no ordinary write path" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">try {
    if (prev.responseCode in [&apos;400&apos;, &apos;404&apos;, &apos;405&apos;]) return
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    def errorCode = (envelope.error?.code ?: envelope.errorCode ?: &apos;&apos;).toString()
    if (prev.responseCode == &apos;500&apos; &amp;&amp; envelope.success == false &amp;&amp; envelope.data == null &amp;&amp; errorCode == &apos;INTERNAL_ERROR&apos;) return
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&apos;A generic card update resolved with HTTP &apos; + prev.responseCode +
        &apos; body=&apos; + prev.responseDataAsString +
        &apos;; card status, PAN and expiry must only change through a controlled lifecycle action&apos;)
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;A protected-field write path exists&apos;)
}</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
