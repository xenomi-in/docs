          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="28.16c.3 - Require no card was created: maximumActiveVirtualPans=2 refuses a third card" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;SYNCREJECT_MULTI&apos;) == &apos;true&apos;) {
    SampleResult.setResponseData(&apos;maximumActiveVirtualPans=2 refuses a third card was refused synchronously&apos;, &apos;UTF-8&apos;)
    return
}
def status = vars.get(&apos;STATUS_MULTI&apos;)
if (status == &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;RULE_NOT_ENFORCED&apos;)
    SampleResult.setResponseMessage(&apos;maximumActiveVirtualPans=2 refuses a third card produced a usable card; operation &apos; + vars.get(&apos;OP_MULTI&apos;) +
        &apos; reached CONFIRMED.&apos; + &apos; maximumActiveVirtualPans was not applied at PHYSICAL_WITH_MULTIPLE_VIRTUAL_PANS issuance.&apos;)
} else {
    // FAILED is never written by application code, so a stuck PENDING/UNKNOWN is the real
    // signature of a worker-side abort. Either way no card became usable, but an operation
    // that never resolves is its own defect and is reported as one.
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_UNRESOLVED&apos;)
    SampleResult.setResponseMessage(&apos;maximumActiveVirtualPans=2 refuses a third card was accepted with HTTP 202 and then never resolved: &apos; +
        vars.get(&apos;POLL_MULTI&apos;) + &apos; polls, last status=&apos; + status + &apos;, result=&apos; + vars.get(&apos;REASON_MULTI&apos;) +
        &apos;. The precondition should have been refused at submission.&apos;)
}
SampleResult.setResponseData(SampleResult.getResponseMessage() ?: &apos;&apos;, &apos;UTF-8&apos;)</stringProp>
