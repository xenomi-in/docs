            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="41.60.3 - Require issued card: CLIENT CARD D" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">if (vars.get(&apos;STATUS_CLIENT_CARD_D&apos;) != &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_NOT_CONFIRMED&apos;)
    SampleResult.setResponseMessage(&apos;CLIENT CARD D did not reach CONFIRMED: status=&apos; + vars.get(&apos;STATUS_CLIENT_CARD_D&apos;) +
        &apos;; operation=&apos; + vars.get(&apos;OP_CLIENT_CARD_D&apos;) + &apos;; polls=&apos; + vars.get(&apos;POLL_CLIENT_CARD_D&apos;) +
        &apos;; UNKNOWN observed &apos; + vars.get(&apos;UNKNOWN_CLIENT_CARD_D&apos;) + &apos; times&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
} else {
    SampleResult.setResponseData(&apos;CLIENT CARD D card &apos; + vars.get(&apos;CLIENT_CARD_D&apos;), &apos;UTF-8&apos;)
}</stringProp>
