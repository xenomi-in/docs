            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Existing cards keep working when issuing is switched off" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.cardStatus == &apos;ACTIVE&apos; : &apos;Disabling issuance changed a live card to &apos; + data.cardStatus
    assert data.lifecycleVersion.toString() == vars.get(&apos;Z_VERSION&apos;) : &apos;Disabling issuance advanced lifecycleVersion to &apos; + data.lifecycleVersion
    assert data.maskedPan == vars.get(&apos;Z_PAN&apos;) : &apos;Disabling issuance changed the PAN&apos;
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Disabling issuance disturbed a live card&apos;)
}</stringProp>
