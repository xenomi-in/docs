            <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="19.12.1 - Poll Switch sync: Q08 successor registration" enabled="true">
              <stringProp name="WhileController.condition">${__groovy(vars.get(&apos;SYNC_SUCC_Q&apos;) != &apos;true&apos; &amp;&amp; vars.get(&apos;SYNC_FAILED_SUCC_Q&apos;) != &apos;true&apos; &amp;&amp; Integer.parseInt(vars.get(&apos;SYNCPOLL_SUCC_Q&apos;)) &lt; Integer.parseInt(vars.get(&apos;SWITCH_SYNC_MAX_POLLS&apos;)))}</stringProp>
            </WhileController>
            <hashTree>
              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="19.12.1a - Read Switch sync: Q08 successor registration" enabled="true">
                <intProp name="HTTPSampler.connect_timeout">10000</intProp>
                <intProp name="HTTPSampler.response_timeout">45000</intProp>
                <stringProp name="HTTPSampler.domain">${CMS_HOST}</stringProp>
                <stringProp name="HTTPSampler.port">${CMS_PORT}</stringProp>
                <stringProp name="HTTPSampler.protocol">${CMS_PROTOCOL}</stringProp>
                <stringProp name="HTTPSampler.path">/cms/api/v2/institutions/${INSTITUTION_ID}/cards/${SUCC_Q}/switch-sync</stringProp>
                <stringProp name="HTTPSampler.method">GET</stringProp>
                <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
                <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
                <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
                  <collectionProp name="Arguments.arguments">
