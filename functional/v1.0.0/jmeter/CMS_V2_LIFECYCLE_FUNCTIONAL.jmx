          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="41.03 - Seed no-hold snapshots for four new configuration accounts" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.sql.Sql
try {
    assert vars.get(&apos;ALLOW_TEST_FIXTURES&apos;) == &apos;true&apos;
    def expected = vars.get(&apos;EXPECTED_TEST_DATABASE&apos;)
    assert expected &amp;&amp; vars.get(&apos;DB_URL&apos;).contains(&apos;/&apos; + expected) : &apos;Expected test database is required&apos;
    def db = Sql.newInstance(vars.get(&apos;DB_URL&apos;), vars.get(&apos;DB_USERNAME&apos;), vars.get(&apos;DB_PASSWORD&apos;), &apos;org.postgresql.Driver&apos;)
    try {
        db.withTransaction {
            (1..4).each { n -&gt;
                def id = vars.get(&apos;CLIENT_ACCOUNT_&apos; + n)
                assert id &amp;&amp; id != &apos;NOT_FOUND&apos;
                assert db.executeUpdate(&quot;insert into cms_v2.account_restriction_snapshot(institution_id,account_reference_id,source_version,observed_at,valid_until,evidence_reference) values(?::uuid,?::uuid,1,now(),now()+interval &apos;6 hours&apos;,?)&quot;, [vars.get(&apos;INSTITUTION_ID&apos;),id,vars.get(&apos;RUN_ID&apos;)+&apos;-CLIENT-NO-HOLDS&apos;]) == 1
            }
        }
        SampleResult.setResponseData(&apos;Four synthetic accounts have no-hold test snapshots.&apos;, &apos;UTF-8&apos;)
    } finally { db.close() }
} catch (Exception | AssertionError failure) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;CLIENT_CONFIGURATION_FAILED&apos;)
    SampleResult.setResponseMessage(failure.message ?: &apos;Client configuration assertion failed&apos;)
    SampleResult.setResponseData(SampleResult.getResponseMessage(), &apos;UTF-8&apos;)
}</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223Sampler>
