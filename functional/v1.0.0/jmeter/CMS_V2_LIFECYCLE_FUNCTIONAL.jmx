          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="10.3 - Prepare rejected issuance: A05 issuance on a DRAFT product version" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">vars.put(&apos;BODY_A05&apos;, groovy.json.JsonOutput.toJson([customerReferenceId: vars.get(&apos;CUSTOMER_REFERENCE_ID&apos;), accountReferenceId: vars.get(&apos;ACCOUNT_REF_2&apos;), productId: vars.get(&apos;DRAFT_PRODUCT_ID&apos;), productVersionId: vars.get(&apos;DRAFT_PRODUCT_VERSION_ID&apos;), binRangeId: vars.get(&apos;BIN_RANGE_ID&apos;), activationPolicyVersionId: vars.get(&apos;ACTIVATION_POLICY_VERSION_ID&apos;), accountLinkType: &apos;PRIMARY_FUNDING&apos;, embossedNameLine1: &apos;LF NEGATIVE&apos;]))
vars.put(&apos;KEY_A05&apos;, vars.get(&apos;RUN_ID&apos;) + &apos;-a05&apos;)
vars.put(&apos;POLL_A05&apos;, &apos;0&apos;)
vars.put(&apos;CONT_A05&apos;, &apos;unset&apos;)
vars.put(&apos;SYNCREJECT_A05&apos;, &apos;false&apos;)</stringProp>
