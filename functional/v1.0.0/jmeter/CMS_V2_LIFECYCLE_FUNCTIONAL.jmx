            <IfController guiclass="IfControllerPanel" testclass="IfController" testname="41.61 - W23 Read postrotation card only when issuance completed" enabled="true">
              <stringProp name="IfController.condition">${__groovy(vars.get(&apos;CLIENT_CARD_D&apos;) != null &amp;&amp; !vars.get(&apos;CLIENT_CARD_D&apos;).trim().isEmpty())}</stringProp>
