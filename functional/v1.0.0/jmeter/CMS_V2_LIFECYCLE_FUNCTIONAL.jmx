            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="A fresh profile with the full dimension set" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.controlVersion == 1 : &apos;Successor controlVersion is &apos; + data.controlVersion + &apos;; version 2 usually means the source profile was copied and then reissue-off bumped it&apos;
    assert data.controls?.size() == 10 : &apos;Expected 10 successor dimensions, found &apos; + (data.controls?.size())
    def notAllowed = data.controls.findAll { it.isAllowed != true }.collect { it.geography + &apos;/&apos; + it.channel }
    assert notAllowed.isEmpty() : &apos;The successor is missing product permissions for: &apos; + notAllowed
    def enabled = data.controls.findAll { it.enabled == true }.collect { it.geography + &apos;/&apos; + it.channel } as Set
    assert enabled == ([&apos;DOMESTIC/POS_CONTACT&apos;] as Set) : &apos;Successor enabled set is &apos; + enabled + &apos;; APPLY_PRODUCT_DEFAULTS should leave only domestic POS on&apos;
    assert data.internationalEnabled == false : &apos;Successor international scope is &apos; + data.internationalEnabled
    vars.put(&apos;J1_SUCC_ENABLED&apos;, enabled.toString())
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;The successor control profile was incomplete&apos;)
}</stringProp>
