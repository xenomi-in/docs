                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">def page = Integer.parseInt(vars.get(&apos;SCAN_33_2_PAGE&apos;)) + 1
vars.put(&apos;SCAN_33_2_PAGE&apos;, page.toString())
try {
    assert prev.responseCode == &apos;200&apos; : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.content.every { it.cardNetwork == &apos;VISA&apos; &amp;&amp; it.binStatus == &apos;ACTIVE&apos; } : &apos;The list returned a BIN outside the filter&apos;
    def wanted = [vars.get(&apos;BIN_ID&apos;), vars.get(&apos;BIN8_ID&apos;)] as Set
    def found = (vars.get(&apos;SCAN_33_2_FOUND&apos;) ?: &apos;&apos;).tokenize(&apos;,&apos;) as Set
    found.addAll(data.content.collect { it.binId.toString() }.findAll { it in wanted })
    vars.put(&apos;SCAN_33_2_FOUND&apos;, found.join(&apos;,&apos;))
    if (found.containsAll(wanted) || data.last == true) vars.put(&apos;SCAN_33_2_MORE&apos;, &apos;false&apos;)
} catch (Exception | AssertionError failure) {
    vars.put(&apos;SCAN_33_2_MORE&apos;, &apos;false&apos;)
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;BIN list/filter page failed&apos;)
}</stringProp>
