          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="33.18.3 - Require no card was created: issuance from a SUSPENDED range" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;SYNCREJECT_SUSPR&apos;) == &apos;true&apos;) {
    SampleResult.setResponseData(&apos;issuance from a SUSPENDED range was refused synchronously&apos;, &apos;UTF-8&apos;)
    return
}
def status = vars.get(&apos;STATUS_SUSPR&apos;)
if (status == &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;RULE_NOT_ENFORCED&apos;)
    SampleResult.setResponseMessage(&apos;issuance from a SUSPENDED range produced a usable card; operation &apos; + vars.get(&apos;OP_SUSPR&apos;) +
        &apos; reached CONFIRMED.&apos; + &apos; No rule in the issuance path rejected it.&apos;)
} else {
    // FAILED is never written by application code, so a stuck PENDING/UNKNOWN is the real
    // signature of a worker-side abort. Either way no card became usable, but an operation
    // that never resolves is its own defect and is reported as one.
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_UNRESOLVED&apos;)
    SampleResult.setResponseMessage(&apos;issuance from a SUSPENDED range was accepted with HTTP 202 and then never resolved: &apos; +
        vars.get(&apos;POLL_SUSPR&apos;) + &apos; polls, last status=&apos; + status + &apos;, result=&apos; + vars.get(&apos;REASON_SUSPR&apos;) +
        &apos;. The precondition should have been refused at submission.&apos;)
}
SampleResult.setResponseData(SampleResult.getResponseMessage() ?: &apos;&apos;, &apos;UTF-8&apos;)</stringProp>
