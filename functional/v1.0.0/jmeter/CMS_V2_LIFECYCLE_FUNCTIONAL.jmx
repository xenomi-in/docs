          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="24.6.2a - Read replacement request: T02 lineage renewal" enabled="true">
              <intProp name="HTTPSampler.connect_timeout">10000</intProp>
              <intProp name="HTTPSampler.response_timeout">45000</intProp>
              <stringProp name="HTTPSampler.domain">${CMS_HOST}</stringProp>
              <stringProp name="HTTPSampler.port">${CMS_PORT}</stringProp>
              <stringProp name="HTTPSampler.protocol">${CMS_PROTOCOL}</stringProp>
              <stringProp name="HTTPSampler.path">/cms/api/v2/institutions/${INSTITUTION_ID}/cards/${CARD_T}/replacement/${RREQ_SUCC_T}</stringProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
                <collectionProp name="Arguments.arguments">
                </collectionProp>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Poll interval" enabled="true">
                <stringProp name="ConstantTimer.delay">${POLL_INTERVAL_MS}</stringProp>
              </ConstantTimer>
              <hashTree/>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Ignore HTTP status" enabled="true">
                <collectionProp name="Asserion.test_strings"/>
                <stringProp name="Assertion.custom_message"></stringProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                <boolProp name="Assertion.assume_success">true</boolProp>
                <intProp name="Assertion.test_type">1</intProp>
              </ResponseAssertion>
              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Capture replacement status" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">try {
    vars.put(&apos;RPOLL_SUCC_T&apos;, (Integer.parseInt(vars.get(&apos;RPOLL_SUCC_T&apos;)) + 1).toString())
    if (Integer.parseInt(vars.get(&apos;RPOLL_SUCC_T&apos;)) &gt;= Integer.parseInt(vars.get(&apos;MAX_POLLS&apos;))) {
        vars.put(&apos;RCONT_SUCC_T&apos;, &apos;false&apos;)
    }
    if (prev.responseCode == &apos;404&apos;) return
    assert prev.responseCode == &apos;200&apos; : &apos;Unexpected HTTP status: &apos; + prev.responseCode
    def data = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString).data
    def status = (data.operationStatus ?: data.requestStatus)?.toString()
    vars.put(&apos;RSTATUS_SUCC_T&apos;, status ?: &apos;PENDING&apos;)
    if (data.replacementCardId) vars.put(&apos;SUCC_T&apos;, data.replacementCardId.toString())
    if (data.resolvedPanStrategy) vars.put(&apos;RRESOLVED_SUCC_T&apos;, data.resolvedPanStrategy.toString())
    if (data.sourceCardStatus) vars.put(&apos;RSOURCE_SUCC_T&apos;, data.sourceCardStatus.toString())
    if (status == &apos;UNKNOWN&apos;) {
        vars.put(&apos;RUNKNOWN_SUCC_T&apos;, (Integer.parseInt(vars.get(&apos;RUNKNOWN_SUCC_T&apos;)) + 1).toString())
    }
    if (status in [&apos;CONFIRMED&apos;, &apos;COMPLETED&apos;, &apos;FAILED&apos;, &apos;REJECTED&apos;]) vars.put(&apos;RCONT_SUCC_T&apos;, &apos;false&apos;)
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Replacement poll failed&apos;)
}</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
              </JSR223Assertion>
