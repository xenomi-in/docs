            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Every dimension reports a per-transaction limit in institution currency" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    assert data.controls?.size() == 10
    assert data.controls.every { it.currencyCode == &apos;INR&apos; } : &apos;Control currencies are &apos; + (data.controls.collect { it.currencyCode } as Set)
    def ceiling = Long.parseLong(vars.get(&apos;PRODUCT_LIMIT_MAX_MINOR&apos;))
    def over = data.controls.findAll { it.perTransactionLimitMinor != null &amp;&amp; it.perTransactionLimitMinor &gt; ceiling }
    assert over.isEmpty() : &apos;A card limit already exceeds the product ceiling: &apos; + over.collect { it.geography + &apos;/&apos; + it.channel + &apos;=&apos; + it.perTransactionLimitMinor }
    vars.put(&apos;I_BASE_VERSION&apos;, data.controlVersion.toString())
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Initial card limits were not as configured&apos;)
}</stringProp>
