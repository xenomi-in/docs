          </hashTree>
          <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="26.5.2 - Poll rejected issuance: A02 issuance while the institution has issuing disabled" enabled="true">
            <stringProp name="WhileController.condition">${__groovy(vars.get(&apos;CONT_A02&apos;) == &apos;true&apos; &amp;&amp; Integer.parseInt(vars.get(&apos;POLL_A02&apos;)) &lt; Integer.parseInt(vars.get(&apos;MAX_POLLS&apos;)))}</stringProp>
          </WhileController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="26.5.2a - Read rejected issuance operation: A02 issuance while the institution has issuing disabled" enabled="true">
              <intProp name="HTTPSampler.connect_timeout">10000</intProp>
              <intProp name="HTTPSampler.response_timeout">45000</intProp>
              <stringProp name="HTTPSampler.domain">${CMS_HOST}</stringProp>
              <stringProp name="HTTPSampler.port">${CMS_PORT}</stringProp>
              <stringProp name="HTTPSampler.protocol">${CMS_PROTOCOL}</stringProp>
              <stringProp name="HTTPSampler.path">/cms/api/v2/institutions/${INSTITUTION_ID}/cards/issuance-operations/${OP_A02}</stringProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
                <collectionProp name="Arguments.arguments">
                </collectionProp>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Poll interval" enabled="true">
                <stringProp name="ConstantTimer.delay">${POLL_INTERVAL_MS}</stringProp>
              </ConstantTimer>
              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Capture status" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">try {
    vars.put(&apos;POLL_A02&apos;, (Integer.parseInt(vars.get(&apos;POLL_A02&apos;)) + 1).toString())
    assert prev.responseCode == &apos;200&apos;
    def data = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString).data
    vars.put(&apos;STATUS_A02&apos;, data.status.toString())
    // There is no failure-reason column on the operation; &apos;result&apos; is the only payload.
    vars.put(&apos;REASON_A02&apos;, (data.result ?: &apos;no result payload&apos;).toString())
    if (data.status in [&apos;FAILED&apos;, &apos;CONFIRMED&apos;]) vars.put(&apos;CONT_A02&apos;, &apos;false&apos;)
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Poll failed&apos;)
}</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
              </JSR223Assertion>
              <hashTree/>
            </hashTree>
          </hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="26.5.3 - Require no card was created: A02 issuance while the institution has issuing disabled" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&apos;SYNCREJECT_A02&apos;) == &apos;true&apos;) {
    SampleResult.setResponseData(&apos;A02 issuance while the institution has issuing disabled was refused synchronously&apos;, &apos;UTF-8&apos;)
    return
}
def status = vars.get(&apos;STATUS_A02&apos;)
if (status == &apos;CONFIRMED&apos;) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;RULE_NOT_ENFORCED&apos;)
    SampleResult.setResponseMessage(&apos;A02 issuance while the institution has issuing disabled produced a usable card; operation &apos; + vars.get(&apos;OP_A02&apos;) +
        &apos; reached CONFIRMED.&apos; + &apos; The institution cardIssuanceEnabled switch was not applied at issuance.&apos;)
} else {
    // FAILED is never written by application code, so a stuck PENDING/UNKNOWN is the real
    // signature of a worker-side abort. Either way no card became usable, but an operation
    // that never resolves is its own defect and is reported as one.
    SampleResult.setSuccessful(false)
    SampleResult.setResponseCode(&apos;ISSUANCE_UNRESOLVED&apos;)
    SampleResult.setResponseMessage(&apos;A02 issuance while the institution has issuing disabled was accepted with HTTP 202 and then never resolved: &apos; +
        vars.get(&apos;POLL_A02&apos;) + &apos; polls, last status=&apos; + status + &apos;, result=&apos; + vars.get(&apos;REASON_A02&apos;) +
        &apos;. The precondition should have been refused at submission.&apos;)
}
SampleResult.setResponseData(SampleResult.getResponseMessage() ?: &apos;&apos;, &apos;UTF-8&apos;)</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
          </JSR223Sampler>
          <hashTree/>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="26.5b - Note the outcome of the disabled-issuance probe" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def status = vars.get(&apos;STATUS_A02&apos;)
def refused = vars.get(&apos;SYNCREJECT_A02&apos;) == &apos;true&apos;
SampleResult.setResponseData(refused
    ? &apos;Issuance was refused while cardIssuanceEnabled=false&apos;
    : &apos;Issuance was NOT refused while cardIssuanceEnabled=false; operation &apos; + vars.get(&apos;OP_A02&apos;) + &apos; ended as &apos; + status,
    &apos;UTF-8&apos;)</stringProp>
