            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Each thread is accepted, replayed or told the first is in flight" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">try {
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    if (prev.responseCode == &apos;202&apos;) {
        assert envelope.success == true
        vars.put(&apos;R03_OP&apos;, envelope.data.operationId.toString())
    } else {
        assert prev.responseCode == &apos;409&apos; : &apos;A concurrent replay must be 202 or 409 IDEMPOTENCY_IN_PROGRESS, got HTTP &apos; + prev.responseCode
        assert envelope.success == false
        def code = envelope.error?.code ?: envelope.errorCode
        assert code in [&apos;IDEMPOTENCY_IN_PROGRESS&apos;, &apos;IDEMPOTENCY_CONFLICT&apos;] : &apos;Error code is &apos; + code
    }
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Concurrent issuance behaved unexpectedly&apos;)
}</stringProp>
