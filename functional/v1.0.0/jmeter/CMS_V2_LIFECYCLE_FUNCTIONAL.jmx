              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Only the intended dimensions carry the test limits" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">try {
    assert prev.responseCode in [&apos;200&apos;, &apos;201&apos;] : &apos;Unexpected HTTP status: &apos; + prev.responseCode + &apos; body=&apos; + prev.responseDataAsString
    def envelope = new groovy.json.JsonSlurper().parseText(prev.responseDataAsString)
    assert envelope.success == true
    def data = envelope.data
    def moto = data.controls.find { it.geography == &apos;DOMESTIC&apos; &amp;&amp; it.channel == &apos;MOTO&apos; }
    assert moto.enabled == false
    def ceiling = Long.parseLong(vars.get(&apos;LIMIT_AT_CEILING&apos;))
    def atm = data.controls.find { it.geography == &apos;DOMESTIC&apos; &amp;&amp; it.channel == &apos;ATM&apos; }
    assert atm.perTransactionLimitMinor == null || atm.perTransactionLimitMinor &lt;= ceiling : &apos;An unrelated dimension now carries &apos; + atm.perTransactionLimitMinor
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;A limit change leaked into unrelated dimensions&apos;)
}</stringProp>
