    assert data.policyId == vars.get(&apos;RENEWAL_POLICY_ID&apos;)
    assert data.panStrategy == &apos;PRESERVE_EXISTING_PAN&apos;
    assert data.controlStrategy == &apos;APPLY_PRODUCT_DEFAULTS&apos;
    assert data.pinStrategy == &apos;CUSTOMER_RESET_REQUIRED&apos;
    assert data.expiryStrategy == &apos;GENERATE_NEW_EXPIRY&apos;
    assert data.accountLinkStrategy == &apos;PRESERVE_ACCOUNT_LINK&apos;
    assert data.oldCardUsagePolicy == &apos;BLOCK_ON_EXPIRY&apos;
} catch (Exception | AssertionError failure) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(failure.message ?: &apos;Replacement policy get failed&apos;)
